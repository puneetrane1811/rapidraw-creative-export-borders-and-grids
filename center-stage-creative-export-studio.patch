@@ -0,0 +1,490 @@
+import React, { useMemo } from 'react';
+import { useExportStore } from '../../../../store/useExportStore';
+import { formatExifSummary } from '../../right/ExportCommons';
+import { WatermarkAnchor } from '../../../ui/ExportImportProperties';
+
+interface CreativeExportOverlayProps {
+  imageWidth: number;
+  imageHeight: number;
+  selectedImage: any;
+  isWgpuActive?: boolean;
+}
+
+export default function CreativeExportOverlay({
+  imageWidth,
+  imageHeight,
+  selectedImage,
+  isWgpuActive = false,
+}: CreativeExportOverlayProps) {
+  const {
+    enableBorder,
+    borderSize,
+    borderColor,
+    enablePolaroid,
+    polaroidBottomMultiplier,
+    enableKeyline,
+    keylineSize,
+    keylineColor,
+    keylineInset,
+    enableExifBadge,
+    exifBadgeStyle,
+    exifBadgeAlignment,
+    exifShowCamera,
+    exifShowLens,
+    exifShowSettings,
+    exifShowDate,
+    exifCustomText,
+    exifBadgeBgColor,
+    exifBadgeTextColor,
+    enableWatermark,
+    watermarkType,
+    watermarkText,
+    watermarkColor,
+    watermarkPath,
+    watermarkAnchor,
+    watermarkScale,
+    watermarkOpacity,
+    watermarkCustomPlacement,
+    watermarkCustomX,
+    watermarkCustomY,
+    enableGridOverlay,
+    gridOverlayRows,
+    gridOverlayCols,
+    gridOverlayColor,
+    gridOverlayOpacity,
+    gridOverlaySize,
+    enableTileSplit,
+    tileSplitColumns,
+    tileSplitRows,
+    tileBorderEachTile,
+  } = useExportStore();
+
+  const exifData = useMemo(() => formatExifSummary(selectedImage?.exif), [selectedImage?.exif]);
+
+  if (
+    imageWidth <= 0 ||
+    imageHeight <= 0 ||
+    (!enableBorder &&
+      !enableKeyline &&
+      !enableExifBadge &&
+      !enableWatermark &&
+      !enableGridOverlay &&
+      !enableTileSplit)
+  ) {
+    return null;
+  }
+
+  // Border & Mat padding calculations
+  const padX = enableBorder ? Math.max(1, Math.round(imageWidth * (borderSize / 100))) : 0;
+  const padYTop = enableBorder ? Math.max(1, Math.round(imageHeight * (borderSize / 100))) : 0;
+
+  let extraBottom = 0;
+  if (enablePolaroid) {
+    extraBottom = Math.round(padYTop * Math.max(1, polaroidBottomMultiplier - 1));
+  } else if (enableExifBadge && exifBadgeStyle === 'bottom_strip') {
+    extraBottom = Math.max(38, Math.round(padYTop * 1.5));
+  }
+
+  const padYBottom = padYTop + extraBottom;
+
+  // Keyline calculations
+  const keylinePx = Math.max(1, Math.round((keylineSize / 100) * Math.min(imageWidth, imageHeight)));
+  const keylineInsetPx = Math.round((keylineInset / 100) * Math.min(imageWidth, imageHeight));
+
+  // Frame outer dimensions
+  const outerX = -padX;
+  const outerY = -padYTop;
+  const outerW = imageWidth + padX * 2;
+  const outerH = imageHeight + padYTop + padYBottom;
+
+  // Watermark position calculation
+  const getWatermarkStyle = () => {
+    let xPercent = 85;
+    let yPercent = 90;
+
+    if (watermarkCustomPlacement) {
+      xPercent = watermarkCustomX;
+      yPercent = watermarkCustomY;
+    } else {
+      switch (watermarkAnchor) {
+        case WatermarkAnchor.TopLeft:
+          xPercent = 5;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.TopCenter:
+          xPercent = 50;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.TopRight:
+          xPercent = 95;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.CenterLeft:
+          xPercent = 5;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.Center:
+          xPercent = 50;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.CenterRight:
+          xPercent = 95;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.BottomLeft:
+          xPercent = 5;
+          yPercent = 95;
+          break;
+        case WatermarkAnchor.BottomCenter:
+          xPercent = 50;
+          yPercent = 95;
+          break;
+        case WatermarkAnchor.BottomRight:
+        default:
+          xPercent = 95;
+          yPercent = 95;
+          break;
+      }
+    }
+
+    const transformOrigin = `${xPercent}% ${yPercent}%`;
+    const translate =
+      xPercent > 66
+        ? yPercent > 66
+          ? 'translate(-100%, -100%)'
+          : yPercent < 33
+            ? 'translate(-100%, 0)'
+            : 'translate(-100%, -50%)'
+        : xPercent < 33
+          ? yPercent > 66
+            ? 'translate(0, -100%)'
+            : yPercent < 33
+              ? 'translate(0, 0)'
+              : 'translate(0, -50%)'
+          : yPercent > 66
+            ? 'translate(-50%, -100%)'
+            : yPercent < 33
+              ? 'translate(-50%, 0)'
+              : 'translate(-50%, -50%)';
+
+    return {
+      position: 'absolute' as const,
+      left: `${(imageWidth * xPercent) / 100}px`,
+      top: `${(imageHeight * yPercent) / 100}px`,
+      transform: translate,
+      transformOrigin,
+      opacity: watermarkOpacity / 100,
+      pointerEvents: 'none' as const,
+    };
+  };
+
+  const watermarkFontSize = Math.max(12, Math.round(imageWidth * (watermarkScale / 250)));
+
+  return (
+    <div
+      className="absolute pointer-events-none"
+      style={{
+        left: 0,
+        top: 0,
+        width: `${imageWidth}px`,
+        height: `${imageHeight}px`,
+        overflow: 'visible',
+        zIndex: 20,
+      }}
+    >
+      {/* 1. Outer Frame / Border / Mat */}
+      {(enableBorder || (enableExifBadge && exifBadgeStyle === 'bottom_strip')) && (
+        <svg
+          className="absolute pointer-events-none"
+          style={{
+            left: `${outerX}px`,
+            top: `${outerY}px`,
+            width: `${outerW}px`,
+            height: `${outerH}px`,
+            overflow: 'visible',
+          }}
+        >
+          {/* Mat background: fills outer frame except the transparent inner hole for the photo */}
+          <path
+            fill={borderColor || '#ffffff'}
+            fillRule="evenodd"
+            d={`
+              M 0,0
+              H ${outerW}
+              V ${outerH}
+              H 0
+              Z
+              M ${padX},${padYTop}
+              V ${padYTop + imageHeight}
+              H ${padX + imageWidth}
+              V ${padYTop}
+              Z
+            `}
+          />
+
+          {/* 2. Inset Keyline */}
+          {enableKeyline && (
+            <rect
+              x={padX - keylineInsetPx}
+              y={padYTop - keylineInsetPx}
+              width={imageWidth + keylineInsetPx * 2}
+              height={imageHeight + keylineInsetPx * 2}
+              fill="none"
+              stroke={keylineColor || '#000000'}
+              strokeWidth={keylinePx}
+              style={{ vectorEffect: 'non-scaling-stroke' }}
+            />
+          )}
+
+          {/* 3. EXIF Gallery Bottom Strip Text */}
+          {enableExifBadge && exifBadgeStyle === 'bottom_strip' && (
+            <g
+              transform={`translate(0, ${padYTop + imageHeight})`}
+              fill={exifBadgeTextColor || '#111827'}
+            >
+              {/* Bottom strip background */}
+              <rect
+                x={0}
+                y={0}
+                width={outerW}
+                height={padYBottom - padYTop}
+                fill={exifBadgeBgColor || borderColor || '#ffffff'}
+              />
+
+              {exifBadgeAlignment === 'center' ? (
+                // Centered Gallery Layout
+                <g textAnchor="middle" style={{ fontVariantNumeric: 'tabular-nums' }}>
+                  <text
+                    x={outerW / 2}
+                    y={Math.round(extraBottom * 0.44)}
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(10, Math.min(14, Math.round(outerW / 55)))}px`,
+                      fontWeight: 600,
+                      letterSpacing: '0.04em',
+                    }}
+                  >
+                    {[
+                      exifShowCamera ? exifData.camera : '',
+                      exifShowLens && exifData.lens ? `• ${exifData.lens}` : '',
+                      exifCustomText ? `• ${exifCustomText}` : '',
+                    ]
+                      .filter(Boolean)
+                      .join(' ')}
+                  </text>
+                  <text
+                    x={outerW / 2}
+                    y={Math.round(extraBottom * 0.78)}
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(9, Math.min(12, Math.round(outerW / 68)))}px`,
+                      fontWeight: 400,
+                      opacity: 0.75,
+                      letterSpacing: '0.02em',
+                    }}
+                  >
+                    {[
+                      exifShowSettings ? exifData.settings : '',
+                      exifShowDate && exifData.date ? `• ${exifData.date}` : '',
+                    ]
+                      .filter(Boolean)
+                      .join(' ')}
+                  </text>
+                </g>
+              ) : (
+                // Split Corners Layout
+                <g style={{ fontVariantNumeric: 'tabular-nums' }}>
+                  {/* Left Column */}
+                  <text
+                    x={Math.max(16, padX)}
+                    y={Math.round(extraBottom * 0.44)}
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(10, Math.min(14, Math.round(outerW / 55)))}px`,
+                      fontWeight: 600,
+                    }}
+                  >
+                    {exifShowCamera ? exifData.camera : ''}
+                  </text>
+                  <text
+                    x={Math.max(16, padX)}
+                    y={Math.round(extraBottom * 0.78)}
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(9, Math.min(12, Math.round(outerW / 68)))}px`,
+                      opacity: 0.75,
+                    }}
+                  >
+                    {[exifShowLens ? exifData.lens : '', exifCustomText]
+                      .filter(Boolean)
+                      .join(' • ')}
+                  </text>
+
+                  {/* Right Column */}
+                  <text
+                    x={outerW - Math.max(16, padX)}
+                    y={Math.round(extraBottom * 0.44)}
+                    textAnchor="end"
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(10, Math.min(13, Math.round(outerW / 60)))}px`,
+                      fontWeight: 500,
+                    }}
+                  >
+                    {exifShowSettings ? exifData.settings : ''}
+                  </text>
+                  <text
+                    x={outerW - Math.max(16, padX)}
+                    y={Math.round(extraBottom * 0.78)}
+                    textAnchor="end"
+                    style={{
+                      fontFamily: 'system-ui, -apple-system, sans-serif',
+                      fontSize: `${Math.max(9, Math.min(11, Math.round(outerW / 70)))}px`,
+                      opacity: 0.7,
+                    }}
+                  >
+                    {exifShowDate ? exifData.date : ''}
+                  </text>
+                </g>
+              )}
+            </g>
+          )}
+        </svg>
+      )}
+
+      {/* 4. Floating Glass Pill EXIF Badge */}
+      {enableExifBadge && exifBadgeStyle === 'overlay_badge' && (
+        <div
+          className="absolute bottom-3 right-3 px-3 py-1.5 rounded-full shadow-lg backdrop-blur-md flex items-center gap-2 pointer-events-none"
+          style={{
+            backgroundColor: exifBadgeBgColor || 'rgba(0, 0, 0, 0.65)',
+            color: exifBadgeTextColor || '#ffffff',
+            border: '1px solid rgba(255, 255, 255, 0.15)',
+            fontSize: `${Math.max(10, Math.min(13, Math.round(imageWidth / 65)))}px`,
+            fontFamily: 'system-ui, -apple-system, sans-serif',
+            maxWidth: '90%',
+          }}
+        >
+          {exifShowCamera && <span className="font-semibold">{exifData.camera}</span>}
+          {exifShowLens && exifData.lens && <span className="opacity-75">{exifData.lens}</span>}
+          {exifShowSettings && <span className="opacity-90">{exifData.settings}</span>}
+          {exifShowDate && exifData.date && <span className="opacity-60">{exifData.date}</span>}
+          {exifCustomText && <span className="font-medium">{exifCustomText}</span>}
+        </div>
+      )}
+
+      {/* 5. Typography / Watermarks */}
+      {enableWatermark && (
+        <div style={getWatermarkStyle()}>
+          {watermarkType === 'text' && watermarkText ? (
+            <div
+              style={{
+                color: watermarkColor || '#ffffff',
+                fontSize: `${watermarkFontSize}px`,
+                fontFamily: 'system-ui, -apple-system, sans-serif',
+                fontWeight: 600,
+                textShadow: '0 1px 3px rgba(0,0,0,0.85), 0 0 8px rgba(0,0,0,0.4)',
+                whiteSpace: 'nowrap',
+                letterSpacing: '0.04em',
+              }}
+            >
+              {watermarkText}
+            </div>
+          ) : watermarkType === 'image' && watermarkPath ? (
+            <img
+              src={watermarkPath}
+              alt="Watermark"
+              style={{
+                width: `${Math.round(imageWidth * (watermarkScale / 100))}px`,
+                height: 'auto',
+                filter: 'drop-shadow(0 2px 4px rgba(0,0,0,0.5))',
+              }}
+            />
+          ) : null}
+        </div>
+      )}
+
+      {/* 6. Composition Grid Overlay (Standard Export) */}
+      {enableGridOverlay && (
+        <svg
+          className="absolute inset-0 pointer-events-none"
+          style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
+        >
+          {Array.from({ length: gridOverlayCols - 1 }).map((_, i) => {
+            const x = ((i + 1) / gridOverlayCols) * imageWidth;
+            return (
+              <line
+                key={`v-grid-${i}`}
+                x1={x}
+                y1={0}
+                x2={x}
+                y2={imageHeight}
+                stroke={gridOverlayColor || '#ffffff'}
+                strokeWidth={gridOverlaySize || 1}
+                strokeOpacity={gridOverlayOpacity / 100}
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+          {Array.from({ length: gridOverlayRows - 1 }).map((_, i) => {
+            const y = ((i + 1) / gridOverlayRows) * imageHeight;
+            return (
+              <line
+                key={`h-grid-${i}`}
+                x1={0}
+                y1={y}
+                x2={imageWidth}
+                y2={y}
+                stroke={gridOverlayColor || '#ffffff'}
+                strokeWidth={gridOverlaySize || 1}
+                strokeOpacity={gridOverlayOpacity / 100}
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+        </svg>
+      )}
+
+      {/* 7. Multi-Tile Splitter Slice Guides (Standard Export) */}
+      {enableTileSplit && (
+        <svg
+          className="absolute inset-0 pointer-events-none"
+          style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
+        >
+          {Array.from({ length: tileSplitColumns - 1 }).map((_, i) => {
+            const x = ((i + 1) / tileSplitColumns) * imageWidth;
+            return (
+              <line
+                key={`tile-v-${i}`}
+                x1={x}
+                y1={0}
+                x2={x}
+                y2={imageHeight}
+                stroke="#38bdf8"
+                strokeWidth="1.5"
+                strokeDasharray="6 4"
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+          {Array.from({ length: tileSplitRows - 1 }).map((_, i) => {
+            const y = ((i + 1) / tileSplitRows) * imageHeight;
+            return (
+              <line
+                key={`tile-h-${i}`}
+                x1={0}
+                y1={y}
+                x2={imageWidth}
+                y2={y}
+                stroke="#38bdf8"
+                strokeWidth="1.5"
+                strokeDasharray="6 4"
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+        </svg>
+      )}
+    </div>
+  );
+}
