+const loadPersistedCreativeSettings = (): Record<string, Partial<CreativeExportSettings>> => {
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_CREATIVE_SETTINGS_KEY);
+    return raw ? JSON.parse(raw) : {};
+  } catch (err) {
+    console.error('Failed to load creative settings from localStorage:', err);
+    return {};
+  }
+};
+
+const savePersistedCreativeSettings = (data: Record<string, Partial<CreativeExportSettings>>) => {
+  try {
+    localStorage.setItem(LOCAL_STORAGE_CREATIVE_SETTINGS_KEY, JSON.stringify(data));
+  } catch (err) {
+    console.error('Failed to save creative settings to localStorage:', err);
+  }
+};
+
+const loadPersistedCreativePresets = (): CreativeExportPreset[] => {
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_CREATIVE_PRESETS_KEY);
+    const userPresets: CreativeExportPreset[] = raw ? JSON.parse(raw) : [];
+    return [...BUILT_IN_CREATIVE_PRESETS, ...userPresets];
+  } catch (err) {
+    console.error('Failed to load creative presets from localStorage:', err);
+    return BUILT_IN_CREATIVE_PRESETS;
+  }
+};
+
+const savePersistedCreativePresets = (presets: CreativeExportPreset[]) => {
+  try {
+    const userPresets = presets.filter((p) => !p.isBuiltIn);
+    localStorage.setItem(LOCAL_STORAGE_CREATIVE_PRESETS_KEY, JSON.stringify(userPresets));
+  } catch (err) {
+    console.error('Failed to save creative presets to localStorage:', err);
