+              <span className="font-mono font-medium text-text-primary">
+                {isEstimating ? (
+                  <span className="text-text-secondary animate-pulse">Calculating size...</span>
+                ) : estimatedSize !== null ? (
+                  `~${formatBytes(estimatedSize, t)}`
+                ) : (
+                  '--'
+                )}
+              </span>
+            </div>
+
+            {/* Progress indicator during batch export */}
+            {isExporting && progress && (
+              <div className="space-y-1">
+                <div className="flex justify-between text-xs text-text-secondary">
+                  <span>Exporting...</span>
+                  <span className="font-mono">
+                    {progress.current ?? 0} / {progress.total}
+                  </span>
+                </div>
+                <div className="w-full h-1.5 bg-surface rounded-full overflow-hidden">
+                  <div
+                    className="h-full bg-accent transition-all duration-200"
+                    style={{
+                      width: `${progress.total > 0 ? ((progress.current ?? 0) / progress.total) * 100 : 0}%`,
+                    }}
+                  />
+                </div>
+              </div>
+            )}
+
+            {/* Error Message if export failed */}
+            {status === Status.Error && errorMessage && (
+              <div className="p-2 rounded bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs">
+                {errorMessage}
+              </div>
+            )}
+
+            {/* Action Buttons */}
+            <div className="flex items-center gap-2.5 pt-1">
+              {isExporting ? (
+                <button
+                  type="button"
+                  onClick={handleCancel}
+                  disabled={isCancelling}
+                  className="w-full py-2.5 px-4 rounded-lg bg-surface text-text-primary hover:bg-surface-hover font-semibold text-xs flex items-center justify-center gap-2 transition-colors disabled:opacity-50"
+                >
+                  <Ban size={15} />
+                  <span>{isCancelling ? 'Cancelling...' : 'Cancel Export'}</span>
+                </button>
+              ) : (
+                <>
+                  <button
+                    type="button"
+                    onClick={onClose}
+                    className="py-2.5 px-4 rounded-lg bg-surface text-text-secondary hover:text-text-primary hover:bg-surface-hover font-medium text-xs transition-colors"
+                  >
+                    Cancel
+                  </button>
+                  <button
+                    type="button"
+                    onClick={handleExport}
+                    disabled={numImages === 0}
+                    className="flex-1 py-2.5 px-4 rounded-lg bg-accent text-button-text hover:bg-accent-hover font-semibold text-xs flex items-center justify-center gap-2 transition-all shadow-md active:scale-[0.99] disabled:opacity-40 disabled:cursor-not-allowed"
+                  >
+                    <FileInput size={15} />
+                    <span>
+                      {numImages > 1
+                        ? `Export ${numImages} Images`
+                        : isCollageActive
+                        ? 'Export Collage'
+                        : 'Export Image'}
+                    </span>
+                  </button>
+                </>
+              )}
+            </div>
+          </div>
+        </div>
+      </div>
+
+      {/* 🎞️ Bottom Photo Roll (Filmstrip) */}
+      <div className="shrink-0 border-t border-surface bg-surface-lowest/95 backdrop-blur-md transition-all duration-200 z-10 flex flex-col">
+        {/* Roll Bar Header */}
+        <div className="h-8 px-4 flex items-center justify-between border-b border-surface/40 text-xs text-text-secondary select-none">
+          <div className="flex items-center gap-2">
+            <Film size={14} className="text-accent" />
+            <span className="font-semibold text-text-primary text-xs">
+              {t('export.photoRoll.title', 'Photo Roll')}
+            </span>
+            <span className="px-1.5 py-0.2 rounded text-[11px] bg-surface text-text-secondary border border-surface/60 font-mono">
+              {multiSelectedPaths.length} of {sortedImageList.length} selected
+            </span>
+          </div>
+
+          <div className="flex items-center gap-3">
+            {isExportPhotoRollVisible && sortedImageList.length > 0 && (
+              <div className="flex items-center gap-1">
+                <button
+                  type="button"
+                  onClick={handleSelectAll}
+                  className="px-2 py-0.5 rounded text-[11px] hover:bg-surface hover:text-text-primary transition-colors"
+                >
+                  Select All
+                </button>
+                <span className="text-surface">•</span>
+                <button
+                  type="button"
+                  onClick={handleClearAll}
+                  className="px-2 py-0.5 rounded text-[11px] hover:bg-surface hover:text-text-primary transition-colors"
+                >
+                  Clear
+                </button>
+                <span className="text-surface">•</span>
+                <button
+                  type="button"
+                  onClick={handleInvertSelection}
+                  className="px-2 py-0.5 rounded text-[11px] hover:bg-surface hover:text-text-primary transition-colors"
+                >
+                  Invert
+                </button>
+              </div>
+            )}
+
+            <button
+              type="button"
+              onClick={() => setUI({ isExportPhotoRollVisible: !isExportPhotoRollVisible })}
+              className="flex items-center gap-1 px-1.5 py-0.5 rounded hover:bg-surface hover:text-text-primary transition-colors text-[11px]"
+              title={isExportPhotoRollVisible ? 'Collapse Photo Roll' : 'Expand Photo Roll'}
+            >
+              <span>{isExportPhotoRollVisible ? 'Hide Roll' : 'Show Roll'}</span>
+              {isExportPhotoRollVisible ? <ChevronDown size={14} /> : <ChevronUp size={14} />}
+            </button>
+          </div>
+        </div>
+
+        {/* Horizontal Photo Roll Track */}
+        {isExportPhotoRollVisible && (
+          <div className="h-28 w-full overflow-x-auto overflow-y-hidden custom-scrollbar px-3 py-2 flex items-center gap-2.5">
+            {sortedImageList.length === 0 ? (
+              <div className="w-full flex items-center justify-center text-xs text-text-secondary/70 italic">
+                No images available in this folder or filter.
+              </div>
+            ) : (
+              sortedImageList.map((img) => {
+                const isSelectedForExport = multiSelectedPaths.includes(img.path);
+                const isActiveInCanvas = activePreviewPath === img.path;
+                const thumbSrc = thumbnails[img.path] || convertFileSrc(img.path);
+                const fname = img.path.split(/[\\/]/).pop() || '';
+
+                return (
+                  <div
+                    key={img.path}
+                    onClick={(e) => handleCardClick(img.path, e)}
+                    className={clsx(
+                      'relative h-24 w-24 shrink-0 rounded-lg overflow-hidden border cursor-pointer group transition-all duration-150',
+                      isActiveInCanvas
+                        ? 'ring-2 ring-accent border-accent shadow-lg scale-[1.02]'
+                        : isSelectedForExport
+                        ? 'border-accent/80 ring-1 ring-accent/40 shadow-sm'
+                        : 'border-surface/80 hover:border-text-secondary/60 hover:shadow-md',
+                    )}
+                    title={`${fname} (Click to preview, ⌘/Ctrl+Click to multi-select)`}
+                  >
+                    {/* Thumbnail Image */}
+                    <img
+                      src={thumbSrc}
+                      alt={fname}
+                      className="w-full h-full object-cover select-none pointer-events-none"
+                      loading="lazy"
+                    />
+
+                    {/* Batch Selection Checkbox Toggle (Top Left) */}
+                    <button
+                      type="button"
+                      onClick={(e) => handleTogglePhotoInExport(img.path, e)}
+                      className={clsx(
+                        'absolute top-1 left-1 p-0.5 rounded transition-all z-10',
+                        isSelectedForExport
+                          ? 'bg-accent text-button-text shadow-md opacity-100'
+                          : 'bg-black/60 text-white/80 hover:bg-black/90 opacity-0 group-hover:opacity-100',
+                      )}
+                      title={isSelectedForExport ? 'Deselect from export' : 'Select for export'}
+                    >
+                      {isSelectedForExport ? <CheckSquare size={14} /> : <Square size={14} />}
+                    </button>
+
+                    {/* Rating badge if present */}
+                    {img.rating > 0 && (
+                      <div className="absolute top-1 right-1 px-1 py-0.2 rounded bg-black/60 backdrop-blur-xs flex items-center gap-0.5 text-[9px] text-amber-400 font-mono">
+                        <Star size={9} className="fill-amber-400" />
+                        <span>{img.rating}</span>
+                      </div>
+                    )}
+
+                    {/* Active Canvas Preview Indicator Dot */}
+                    {isActiveInCanvas && (
+                      <div className="absolute bottom-5 left-1/2 -translate-x-1/2 px-1.5 py-0.2 rounded-full bg-accent text-button-text text-[9px] font-semibold tracking-wider uppercase shadow-md pointer-events-none">
+                        Previewing
+                      </div>
+                    )}
+
+                    {/* Bottom Filename Overlay */}
+                    <div className="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-1 pt-2 pointer-events-none">
+                      <p className="text-[10px] text-white/90 truncate font-mono select-none leading-tight">
+                        {fname}
+                      </p>
+                    </div>
+                  </div>
+                );
+              })
+            )}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
