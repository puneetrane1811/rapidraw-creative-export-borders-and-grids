diff --git a/src/components/panel/editor/overlays/CreativeExportOverlay.tsx b/src/components/panel/editor/overlays/CreativeExportOverlay.tsx
new file mode 100644
index 0000000..d750531
--- /dev/null
+++ b/src/components/panel/editor/overlays/CreativeExportOverlay.tsx
@@ -0,0 +1,859 @@
+import React, { useMemo, useCallback, useEffect } from 'react';
+import { invoke, convertFileSrc } from '@tauri-apps/api/core';
+import { useExportStore } from '../../../../store/useExportStore';
+import { useLibraryStore } from '../../../../store/useLibraryStore';
+import { useProcessStore } from '../../../../store/useProcessStore';
+import { useEditorStore } from '../../../../store/useEditorStore';
+import { formatExifSummary } from '../../right/ExportCommons';
+import { WatermarkAnchor } from '../../../ui/ExportImportProperties';
+
+interface CreativeExportOverlayProps {
+  imageWidth: number;
+  imageHeight: number;
+  selectedImage: any;
+  isWgpuActive?: boolean;
+}
+
+export default function CreativeExportOverlay({
+  imageWidth,
+  imageHeight,
+  selectedImage,
+  isWgpuActive = false,
+}: CreativeExportOverlayProps) {
+  const multiSelectedPaths = useLibraryStore((s) => s.multiSelectedPaths);
+  const thumbnails = useProcessStore((s) => s.thumbnails);
+  const mediumThumbnails = useProcessStore((s) => s.mediumThumbnails);
+  const previews = useProcessStore((s) => s.previews);
+  const finalPreviewUrl = useEditorStore((s) => s.finalPreviewUrl);
+
+  const {
+    enableBorder,
+    borderSize,
+    borderColor,
+    enablePolaroid,
+    polaroidBottomMultiplier,
+    enableKeyline,
+    keylineSize,
+    keylineColor,
+    keylineInset,
+    enableExifBadge,
+    exifBadgeStyle,
+    exifBadgeAlignment,
+    exifShowCamera,
+    exifShowLens,
+    exifShowSettings,
+    exifShowDate,
+    exifCustomText,
+    exifBadgeBgColor,
+    exifBadgeTextColor,
+    enableWatermark,
+    watermarkType,
+    watermarkText,
+    watermarkColor,
+    watermarkPath,
+    watermarkAnchor,
+    watermarkScale,
+    watermarkOpacity,
+    watermarkCustomPlacement,
+    watermarkCustomX,
+    watermarkCustomY,
+    enableGridTools,
+    enableGridOverlay,
+    gridOverlayRows,
+    gridOverlayCols,
+    gridOverlayColor,
+    gridOverlayOpacity,
+    gridOverlaySize,
+    enableTileSplit,
+    tileSplitColumns,
+    tileSplitRows,
+    tileBorderEachTile,
+    enableCollageGrid,
+    collageColumns,
+    collageRows,
+    collageGutter,
+    collageCellFit,
+    borderTopSize,
+    borderBottomSize,
+    borderLeftSize,
+    borderRightSize,
+    borderRadius,
+    borderShadow,
+    enableFilmStrip,
+    filmFormat,
+    filmShowSprockets,
+    filmShowFrameNumber,
+    filmFrameNumber,
+    filmEdgeMarkings,
+    enableCinematicBars,
+    cinematicRatio,
+    cinematicBarColor,
+    analogEffect,
+    lightLeakIntensity,
+    fontFamily,
+    timestampStyle,
+    archiveCatalogLayout,
+  } = useExportStore();
+
+  const isTileSplitActive = enableGridTools && enableTileSplit;
+  const isGridOverlayActive = enableGridTools && enableGridOverlay;
+
+  const effectiveCollagePaths = useMemo(() => {
+    if (multiSelectedPaths.length > 0) return multiSelectedPaths;
+    if (selectedImage?.path) return [selectedImage.path];
+    return [];
+  }, [multiSelectedPaths, selectedImage?.path]);
+
+  const isCollageActive = enableCollageGrid && effectiveCollagePaths.length > 0;
+
+  const getPhotoUrl = useCallback(
+    (path: string) => {
+      if (!path) return '';
+      if (path === selectedImage?.path && finalPreviewUrl) {
+        return finalPreviewUrl;
+      }
+      if (mediumThumbnails[path]) return mediumThumbnails[path];
+      if (thumbnails[path]) return thumbnails[path];
+      if (previews[path]?.url) return previews[path].url;
+      try {
+        return convertFileSrc(path);
+      } catch {
+        return '';
+      }
+    },
+    [selectedImage?.path, finalPreviewUrl, mediumThumbnails, thumbnails, previews],
+  );
+
+  useEffect(() => {
+    if (!isCollageActive) return;
+    const missing = effectiveCollagePaths.filter(
+      (p) => !thumbnails[p] && !mediumThumbnails[p] && !previews[p]?.url,
+    );
+    if (missing.length > 0) {
+      invoke('update_thumbnail_queue', { paths: missing }).catch(() => {});
+    }
+  }, [isCollageActive, effectiveCollagePaths, thumbnails, mediumThumbnails, previews]);
+
+  const exifData = useMemo(() => formatExifSummary(selectedImage?.exif), [selectedImage?.exif]);
+
+  const isAnyFramingActive =
+    enableBorder ||
+    enablePolaroid ||
+    enableFilmStrip ||
+    enableCinematicBars ||
+    (analogEffect && analogEffect !== 'none') ||
+    enableKeyline ||
+    enableExifBadge ||
+    (timestampStyle && timestampStyle !== 'none') ||
+    enableWatermark ||
+    isGridOverlayActive ||
+    isTileSplitActive ||
+    isCollageActive;
+
+  if (imageWidth <= 0 || imageHeight <= 0 || !isAnyFramingActive) {
+    return null;
+  }
+
+  // 1. Normalized Border & Asymmetrical Mat Margins
+  const leftPct = borderLeftSize !== undefined ? borderLeftSize : borderSize;
+  const rightPct = borderRightSize !== undefined ? borderRightSize : borderSize;
+  const topPct = borderTopSize !== undefined ? borderTopSize : borderSize;
+  const bottomPct = borderBottomSize !== undefined ? borderBottomSize : borderSize;
+
+  let padLeft = enableBorder ? Math.max(0, Math.round(imageWidth * (leftPct / 100))) : 0;
+  let padRight = enableBorder ? Math.max(0, Math.round(imageWidth * (rightPct / 100))) : 0;
+  let padTop = enableBorder ? Math.max(0, Math.round(imageHeight * (topPct / 100))) : 0;
+  let padBottom = enableBorder ? Math.max(0, Math.round(imageHeight * (bottomPct / 100))) : 0;
+
+  // Polaroid / Instant Photography Asymmetrical Bottom Chin
+  if (enablePolaroid) {
+    const baseTop = padTop > 0 ? padTop : Math.max(12, Math.round(imageHeight * 0.04));
+    padTop = baseTop;
+    padLeft = padLeft > 0 ? padLeft : Math.max(12, Math.round(imageWidth * 0.04));
+    padRight = padRight > 0 ? padRight : Math.max(12, Math.round(imageWidth * 0.04));
+    padBottom = Math.round(baseTop * Math.max(1.2, polaroidBottomMultiplier));
+  }
+
+  // Film Strip Format Margins
+  if (enableFilmStrip) {
+    const filmTopBottomPad = Math.max(28, Math.round(imageHeight * (Math.max(5, topPct) / 100)));
+    const filmSidePad = Math.max(12, Math.round(imageWidth * (Math.max(2.5, leftPct) / 100)));
+    padTop = Math.max(padTop, filmTopBottomPad);
+    padBottom = Math.max(padBottom, filmTopBottomPad);
+    padLeft = Math.max(padLeft, filmSidePad);
+    padRight = Math.max(padRight, filmSidePad);
+  }
+
+  // EXIF Gallery Bottom Strip Expansion
+  let extraBottomForExif = 0;
+  if (enableExifBadge && exifBadgeStyle === 'bottom_strip') {
+    extraBottomForExif = Math.max(40, Math.round(imageHeight * 0.09));
+    padBottom = Math.max(padBottom, extraBottomForExif);
+  }
+
+  // Cinematic Non-Destructive Letterboxing
+  if (enableCinematicBars) {
+    const targetRatio =
+      cinematicRatio === '2.35:1'
+        ? 2.35
+        : cinematicRatio === '2.00:1'
+        ? 2.0
+        : cinematicRatio === '16:9'
+        ? 16 / 9
+        : 2.39;
+
+    const baseInnerW = imageWidth + padLeft + padRight;
+    const baseInnerH = imageHeight + padTop + padBottom;
+    const currentRatio = baseInnerW / baseInnerH;
+
+    if (currentRatio < targetRatio) {
+      // Image is taller than target cinematic ratio -> add letterbox bars top & bottom
+      const neededTotalHeight = Math.round(baseInnerW / targetRatio);
+      if (neededTotalHeight > baseInnerH) {
+        const addY = neededTotalHeight - baseInnerH;
+        padTop += Math.round(addY / 2);
+        padBottom += Math.round(addY / 2);
+      } else {
+        // Alternatively expand width to enclose full height
+        const neededTotalWidth = Math.round(baseInnerH * targetRatio);
+        const addX = Math.max(0, neededTotalWidth - baseInnerW);
+        padLeft += Math.round(addX / 2);
+        padRight += Math.round(addX / 2);
+      }
+    }
+  }
+
+  const outerX = -padLeft;
+  const outerY = -padTop;
+  const outerW = imageWidth + padLeft + padRight;
+  const outerH = imageHeight + padTop + padBottom;
+
+  // Keyline calculations
+  const keylinePx = Math.max(1, Math.round((keylineSize / 100) * Math.min(imageWidth, imageHeight)));
+  const keylineInsetPx = Math.round((keylineInset / 100) * Math.min(imageWidth, imageHeight));
+
+  // Resolved font family
+  const resolvedFontFamily =
+    fontFamily === 'serif'
+      ? "Georgia, Cambria, 'Times New Roman', Times, serif"
+      : fontFamily === 'mono'
+      ? "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
+      : "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
+
+  // Watermark position calculation
+  const getWatermarkStyle = () => {
+    let xPercent = 85;
+    let yPercent = 90;
+
+    if (watermarkCustomPlacement) {
+      xPercent = watermarkCustomX;
+      yPercent = watermarkCustomY;
+    } else {
+      switch (watermarkAnchor) {
+        case WatermarkAnchor.TopLeft:
+          xPercent = 5;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.TopCenter:
+          xPercent = 50;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.TopRight:
+          xPercent = 95;
+          yPercent = 5;
+          break;
+        case WatermarkAnchor.CenterLeft:
+          xPercent = 5;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.Center:
+          xPercent = 50;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.CenterRight:
+          xPercent = 95;
+          yPercent = 50;
+          break;
+        case WatermarkAnchor.BottomLeft:
+          xPercent = 5;
+          yPercent = 95;
+          break;
+        case WatermarkAnchor.BottomCenter:
+          xPercent = 50;
+          yPercent = 95;
+          break;
+        case WatermarkAnchor.BottomRight:
+        default:
+          xPercent = 95;
+          yPercent = 95;
+          break;
+      }
+    }
+
+    const transformOrigin = `${xPercent}% ${yPercent}%`;
+    const translate =
+      xPercent > 66
+        ? yPercent > 66
+          ? 'translate(-100%, -100%)'
+          : yPercent < 33
+          ? 'translate(-100%, 0)'
+          : 'translate(-100%, -50%)'
+        : xPercent < 33
+        ? yPercent > 66
+          ? 'translate(0, -100%)'
+          : yPercent < 33
+          ? 'translate(0, 0)'
+          : 'translate(0, -50%)'
+        : yPercent > 66
+        ? 'translate(-50%, -100%)'
+        : yPercent < 33
+        ? 'translate(-50%, 0)'
+        : 'translate(-50%, -50%)';
+
+    return {
+      position: 'absolute' as const,
+      left: `${(imageWidth * xPercent) / 100}px`,
+      top: `${(imageHeight * yPercent) / 100}px`,
+      transform: translate,
+      transformOrigin,
+      opacity: watermarkOpacity / 100,
+      pointerEvents: 'none' as const,
+    };
+  };
+
+  const watermarkFontSize = Math.max(12, Math.round(imageWidth * (watermarkScale / 250)));
+
+  return (
+    <div
+      className="absolute pointer-events-none"
+      style={{
+        left: 0,
+        top: 0,
+        width: `${imageWidth}px`,
+        height: `${imageHeight}px`,
+        overflow: 'visible',
+        zIndex: 20,
+      }}
+    >
+      {/* 0. Live Multi-Photo Collage Grid */}
+      {isCollageActive && (
+        <div
+          className="absolute inset-0 overflow-hidden pointer-events-none"
+          style={{
+            width: `${imageWidth}px`,
+            height: `${imageHeight}px`,
+            backgroundColor: borderColor || '#111111',
+            display: 'grid',
+            gridTemplateColumns: `repeat(${Math.max(1, collageColumns)}, 1fr)`,
+            gridTemplateRows: `repeat(${Math.max(1, collageRows)}, 1fr)`,
+            gap: `${Math.round((imageWidth / Math.max(1, collageColumns)) * (collageGutter / 100))}px`,
+          }}
+        >
+          {Array.from({ length: Math.max(1, collageColumns) * Math.max(1, collageRows) }).map((_, idx) => {
+            const path = effectiveCollagePaths[idx];
+            const url = path ? getPhotoUrl(path) : null;
+            return (
+              <div
+                key={`collage-cell-${idx}`}
+                className="relative w-full h-full overflow-hidden flex items-center justify-center bg-black/30"
+              >
+                {url ? (
+                  <img
+                    src={url}
+                    alt=""
+                    className="w-full h-full select-none pointer-events-none"
+                    style={{
+                      objectFit: collageCellFit === 'fill' ? 'cover' : 'contain',
+                    }}
+                    loading="eager"
+                    decoding="async"
+                  />
+                ) : (
+                  <div className="flex flex-col items-center justify-center text-white/30 text-xs font-mono select-none">
+                    <span className="text-lg opacity-40">+</span>
+                    <span>Photo {idx + 1}</span>
+                  </div>
+                )}
+                <div className="absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/60 text-[10px] text-white/80 font-mono pointer-events-none backdrop-blur-xs">
+                  {idx + 1}
+                </div>
+              </div>
+            );
+          })}
+        </div>
+      )}
+
+      {/* 1. Outer Frame / Border / Mat / Film Strip / Cinematic Bars */}
+      {(enableBorder ||
+        enablePolaroid ||
+        enableFilmStrip ||
+        enableCinematicBars ||
+        (enableExifBadge && exifBadgeStyle === 'bottom_strip')) && (
+        <svg
+          className="absolute pointer-events-none"
+          style={{
+            left: `${outerX}px`,
+            top: `${outerY}px`,
+            width: `${outerW}px`,
+            height: `${outerH}px`,
+            overflow: 'visible',
+            filter: borderShadow ? 'drop-shadow(0 6px 18px rgba(0, 0, 0, 0.4))' : undefined,
+          }}
+        >
+          <defs>
+            {analogEffect === 'light_leak' && (
+              <linearGradient id="lightLeakGrad" x1="0%" y1="0%" x2="50%" y2="100%">
+                <stop offset="0%" stopColor="#ff7a00" stopOpacity="0.85" />
+                <stop offset="35%" stopColor="#ff4500" stopOpacity="0.45" />
+                <stop offset="70%" stopColor="#ffaa00" stopOpacity="0.15" />
+                <stop offset="100%" stopColor="#000000" stopOpacity="0" />
+              </linearGradient>
+            )}
+          </defs>
+
+          {/* Mat background: fills outer frame except the transparent inner hole for the photo */}
+          <path
+            fill={enableCinematicBars ? cinematicBarColor || '#000000' : borderColor || '#ffffff'}
+            fillRule="evenodd"
+            d={`
+              M 0,0
+              H ${outerW}
+              V ${outerH}
+              H 0
+              Z
+              M ${padLeft},${padTop}
+              V ${padTop + imageHeight}
+              H ${padLeft + imageWidth}
+              V ${padTop}
+              Z
+            `}
+          />
+
+          {/* Film Strip Sprocket Holes & Markings */}
+          {enableFilmStrip && (
+            <g>
+              {filmFormat === '35mm' && filmShowSprockets !== false && (
+                <>
+                  {Array.from({ length: Math.max(4, Math.round(outerW / 36)) }).map((_, i) => {
+                    const count = Math.max(4, Math.round(outerW / 36));
+                    const step = outerW / count;
+                    const sx = i * step + step * 0.25;
+                    const sw = step * 0.5;
+                    const sh = Math.max(8, Math.round(padTop * 0.42));
+                    const syTop = Math.round((padTop - sh) / 2);
+                    const syBottom = outerH - padBottom + Math.round((padBottom - sh) / 2);
+                    return (
+                      <React.Fragment key={`sprocket-${i}`}>
+                        <rect
+                          x={sx}
+                          y={syTop}
+                          width={sw}
+                          height={sh}
+                          rx={2.5}
+                          fill="#000000"
+                          stroke="#27272a"
+                          strokeWidth={0.5}
+                        />
+                        <rect
+                          x={sx}
+                          y={syBottom}
+                          width={sw}
+                          height={sh}
+                          rx={2.5}
+                          fill="#000000"
+                          stroke="#27272a"
+                          strokeWidth={0.5}
+                        />
+                      </React.Fragment>
+                    );
+                  })}
+                </>
+              )}
+
+              {/* Film Edge Text Markings */}
+              <g
+                fill="#a1a1aa"
+                style={{
+                  fontFamily: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
+                  fontSize: `${Math.max(8, Math.min(12, Math.round(outerW / 75)))}px`,
+                  letterSpacing: '0.05em',
+                }}
+              >
+                {/* Top edge text */}
+                <text x={padLeft + 6} y={Math.max(10, Math.round(padTop * 0.85))} fontWeight={600}>
+                  ▲ {filmEdgeMarkings || '36 EXP  •  35MM'}
+                </text>
+                <text
+                  x={outerW - padRight - 6}
+                  y={Math.max(10, Math.round(padTop * 0.85))}
+                  textAnchor="end"
+                  fontWeight={500}
+                >
+                  ISO 400
+                </text>
+
+                {/* Bottom edge text */}
+                <text
+                  x={padLeft + 6}
+                  y={outerH - Math.max(4, Math.round(padBottom * 0.15))}
+                  fontWeight={600}
+                >
+                  FRAME {filmFrameNumber || '01'}  •  ▶▶
+                </text>
+              </g>
+            </g>
+          )}
+
+          {/* Darkroom Print Hairline Border */}
+          {analogEffect === 'darkroom' && (
+            <rect
+              x={padLeft}
+              y={padTop}
+              width={imageWidth}
+              height={imageHeight}
+              fill="none"
+              stroke="#ffffff"
+              strokeWidth={1}
+              strokeOpacity={0.8}
+            />
+          )}
+
+          {/* Subtle Light Leak Overlay */}
+          {analogEffect === 'light_leak' && (
+            <rect
+              x={padLeft}
+              y={padTop}
+              width={imageWidth}
+              height={imageHeight}
+              fill="url(#lightLeakGrad)"
+              opacity={(lightLeakIntensity || 65) / 100}
+              style={{ mixBlendMode: 'screen' }}
+            />
+          )}
+
+          {/* 2. Inset Keyline */}
+          {enableKeyline && (
+            <rect
+              x={padLeft - keylineInsetPx}
+              y={padTop - keylineInsetPx}
+              width={imageWidth + keylineInsetPx * 2}
+              height={imageHeight + keylineInsetPx * 2}
+              fill="none"
+              stroke={keylineColor || '#000000'}
+              strokeWidth={keylinePx}
+              style={{ vectorEffect: 'non-scaling-stroke' }}
+            />
+          )}
+
+          {/* 3. EXIF Gallery Bottom Strip Text */}
+          {enableExifBadge && exifBadgeStyle === 'bottom_strip' && (
+            <g
+              transform={`translate(0, ${padTop + imageHeight})`}
+              fill={exifBadgeTextColor || '#111827'}
+            >
+              {/* Bottom strip background */}
+              <rect
+                x={0}
+                y={0}
+                width={outerW}
+                height={padBottom}
+                fill={exifBadgeBgColor || borderColor || '#ffffff'}
+              />
+
+              {archiveCatalogLayout ? (
+                // Archive Catalog Card Layout
+                <g style={{ fontFamily: resolvedFontFamily, fontVariantNumeric: 'tabular-nums' }}>
+                  <text
+                    x={padLeft + 4}
+                    y={Math.round(padBottom * 0.38)}
+                    style={{
