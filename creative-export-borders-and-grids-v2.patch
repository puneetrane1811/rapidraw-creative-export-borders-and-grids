+fn apply_exif_badge(
+    image: DynamicImage,
+    badge_settings: &ExifBadgeSettings,
+    source_path_str: Option<&str>,
+    fallback_border_color: Option<&str>,
+) -> DynamicImage {
+    if !badge_settings.enabled {
+        return image;
+    }
+
+    let exif_map = if let Some(path_str) = source_path_str {
+        exif_processing::read_rrexif_sidecar(Path::new(path_str))
+            .or_else(|| {
+                if let Ok(bytes) = read_file_mapped(Path::new(path_str)) {
+                    Some(exif_processing::read_exif_data(path_str, &bytes))
+                } else {
+                    None
+                }
+            })
+            .unwrap_or_default()
+    } else {
+        HashMap::new()
+    };
+
+    let mut camera = String::new();
+    if badge_settings.show_camera {
+        let make = exif_map.get("Make").map(|s| s.trim()).unwrap_or("");
+        let model = exif_map.get("Model").map(|s| s.trim()).unwrap_or("");
+        if !model.is_empty() {
+            if !make.is_empty() && !model.to_lowercase().starts_with(&make.to_lowercase()) {
+                camera = format!("{} {}", make, model);
+            } else {
+                camera = model.to_string();
+            }
+        } else if !make.is_empty() {
+            camera = make.to_string();
+        }
+    }
+
+    let mut lens = String::new();
+    if badge_settings.show_lens {
+        if let Some(l) = exif_map.get("LensModel") {
+            lens = l.trim().to_string();
+        }
+    }
+
+    let mut settings_parts = Vec::new();
+    if badge_settings.show_settings {
+        let focal = exif_map
+            .get("FocalLengthIn35mmFilm")
+            .or_else(|| exif_map.get("FocalLength"));
+        if let Some(f_str) = focal {
+            if let Ok(f_val) = f_str.parse::<f32>() {
+                if f_val > 0.0 {
+                    settings_parts.push(format!("{}mm", f_val.round() as u32));
+                }
+            }
+        }
+
+        if let Some(f_str) = exif_map.get("FNumber") {
+            if let Ok(f_val) = f_str.parse::<f32>() {
+                if f_val > 0.0 {
+                    let formatted = format!("{:.1}", f_val);
+                    let clean = formatted.trim_end_matches(".0");
+                    settings_parts.push(format!("ƒ/{}", clean));
+                }
+            }
+        }
+
+        if let Some(e_str) = exif_map.get("ExposureTime") {
+            if let Ok(e_val) = e_str.parse::<f32>() {
+                if e_val > 0.0 {
+                    if e_val < 1.0 {
+                        settings_parts.push(format!("1/{}s", (1.0 / e_val).round() as u32));
+                    } else {
+                        let formatted = format!("{:.1}", e_val);
+                        let clean = formatted.trim_end_matches(".0");
+                        settings_parts.push(format!("{}s", clean));
+                    }
+                }
+            }
+        }
+
+        let iso = exif_map
+            .get("PhotographicSensitivity")
+            .or_else(|| exif_map.get("ISOSpeedRatings"));
+        if let Some(iso_val) = iso {
+            let trimmed = iso_val.trim();
+            if !trimmed.is_empty() {
+                settings_parts.push(format!("ISO {}", trimmed));
+            }
+        }
+    }
+    let settings = settings_parts.join(" • ");
+
+    let mut date_str = String::new();
+    if badge_settings.show_date {
+        if let Some(dt) = exif_map.get("DateTimeOriginal") {
+            let part = dt.split_whitespace().next().unwrap_or(dt);
+            date_str = part.replace(':', "-");
+        }
+    }
+
+    let custom_credit = badge_settings.custom_text.as_deref().unwrap_or("").trim();
+
+    if camera.is_empty() && badge_settings.show_camera && custom_credit.is_empty() {
+        camera = "CAMERA".to_string();
+    }
+
+    let font = match crate::default_font::get_default_font() {
+        Some(f) => f,
+        None => return image,
+    };
+
+    let bg_color_hex = badge_settings
+        .badge_bg_color
+        .as_deref()
+        .or(fallback_border_color)
+        .unwrap_or("#ffffff");
+    let bg_color = parse_border_color(bg_color_hex).unwrap_or(Rgba([255, 255, 255, 255]));
+
+    let text_color_hex = badge_settings
+        .badge_text_color
+        .as_deref()
+        .unwrap_or("#111827");
+    let text_color = parse_border_color(text_color_hex).unwrap_or(Rgba([17, 24, 39, 255]));
+
+    let style = badge_settings.style.as_deref().unwrap_or("bottom_strip");
+    let (width, height) = image.dimensions();
+
+    if style == "overlay_badge" {
+        let mut base_rgba = image.to_rgba8();
+        let font_px = ((width.min(height) as f32 * 0.024).clamp(13.0, 42.0)).round();
+        let scale = ab_glyph::PxScale::from(font_px);
+
+        let mut badge_items = Vec::new();
+        if !camera.is_empty() {
+            badge_items.push(camera);
+        }
+        if !custom_credit.is_empty() {
+            badge_items.push(custom_credit.to_string());
+        }
+        if !settings.is_empty() {
+            badge_items.push(settings);
+        }
+        if !date_str.is_empty() {
+            badge_items.push(date_str);
+        }
+
+        let badge_text = badge_items.join("  |  ");
+        if badge_text.is_empty() {
+            return image;
+        }
+
+        let (text_w, text_h) = imageproc::drawing::text_size(scale, &font, &badge_text);
+        let pad_h = (font_px * 0.9).round() as u32;
+        let pad_v = (font_px * 0.5).round() as u32;
+        let pill_w = text_w + pad_h * 2;
+        let pill_h = text_h + pad_v * 2;
+
+        let margin = (font_px * 1.2).round() as u32;
+        let pill_x = (width.saturating_sub(pill_w + margin)) as i32;
+        let pill_y = (height.saturating_sub(pill_h + margin)) as i32;
+
+        draw_filled_rect(
+            &mut base_rgba,
+            pill_x,
+            pill_y,
+            pill_x + pill_w as i32,
+            pill_y + pill_h as i32,
+            bg_color,
+            0.88,
+        );
+
+        let border_subtle = Rgba([text_color[0], text_color[1], text_color[2], 60]);
+        draw_rect_outline(
+            &mut base_rgba,
+            pill_x,
+            pill_y,
+            pill_x + pill_w as i32,
+            pill_y + pill_h as i32,
+            1,
+            border_subtle,
+            0.9,
+        );
+
+        imageproc::drawing::draw_text_mut(
+            &mut base_rgba,
+            text_color,
+            pill_x + pad_h as i32,
+            pill_y + pad_v as i32,
+            scale,
+            &font,
+            &badge_text,
+        );
+
+        DynamicImage::ImageRgba8(base_rgba)
+    } else {
+        let strip_h = ((height as f32 * 0.11).clamp(44.0, 360.0)).round() as u32;
+        let new_height = height + strip_h;
+        let mut output_buf = ImageBuffer::from_pixel(width, new_height, bg_color);
+
+        imageops::overlay(&mut output_buf, &image.to_rgba8(), 0, 0);
+
+        let font_title_px = ((strip_h as f32 * 0.28).clamp(13.0, 52.0)).round();
+        let font_sub_px = ((strip_h as f32 * 0.21).clamp(10.0, 38.0)).round();
+
+        let scale_title = ab_glyph::PxScale::from(font_title_px);
+        let scale_sub = ab_glyph::PxScale::from(font_sub_px);
+
+        let margin_x = ((width as f32 * 0.04).clamp(20.0, 140.0)).round() as i32;
+        let strip_top = height as i32;
+
+        let left_title = if !camera.is_empty() {
+            camera.clone()
+        } else if !custom_credit.is_empty() {
+            custom_credit.to_string()
+        } else {
+            String::new()
+        };
+
+        let left_sub = if !left_title.is_empty() && left_title != custom_credit && !custom_credit.is_empty() {
+            if !lens.is_empty() {
+                format!("{} • {}", lens, custom_credit)
+            } else {
+                custom_credit.to_string()
+            }
+        } else {
+            lens.clone()
+        };
+
+        let right_title = settings.clone();
+        let right_sub = date_str.clone();
+
+        let y_line1 = strip_top + ((strip_h as f32 * 0.22).round() as i32);
+        let y_line2 = strip_top + ((strip_h as f32 * 0.58).round() as i32);
+
+        let secondary_text_color = Rgba([
+            ((text_color[0] as f32 * 0.75 + bg_color[0] as f32 * 0.25).round() as u8),
+            ((text_color[1] as f32 * 0.75 + bg_color[1] as f32 * 0.25).round() as u8),
+            ((text_color[2] as f32 * 0.75 + bg_color[2] as f32 * 0.25).round() as u8),
+            255,
+        ]);
+
+        let is_center_aligned = badge_settings.alignment.as_deref() == Some("center")
+            || (badge_settings.alignment.as_deref() != Some("split") && (width as f32 / height as f32) > 1.4);
+
+        if is_center_aligned {
+            let mut line1_parts = Vec::new();
+            if !camera.is_empty() {
+                line1_parts.push(camera.clone());
+            }
+            if !lens.is_empty() {
+                line1_parts.push(lens.clone());
+            }
+            if !custom_credit.is_empty() && !line1_parts.contains(&custom_credit.to_string()) {
+                line1_parts.push(custom_credit.to_string());
+            }
+            let line1 = line1_parts.join("  •  ");
+
+            let mut line2_parts = Vec::new();
+            if !settings.is_empty() {
+                line2_parts.push(settings.clone());
+            }
+            if !date_str.is_empty() {
+                line2_parts.push(date_str.clone());
+            }
+            let line2 = line2_parts.join("  •  ");
+
+            if !line1.is_empty() {
+                let (l1_w, _) = imageproc::drawing::text_size(scale_title, &font, &line1);
+                let l1_x = ((width as i32 - l1_w as i32) / 2).max(margin_x);
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    text_color,
+                    l1_x,
+                    y_line1,
+                    scale_title,
+                    &font,
+                    &line1,
+                );
+            }
+
+            if !line2.is_empty() {
+                let (l2_w, _) = imageproc::drawing::text_size(scale_sub, &font, &line2);
+                let l2_x = ((width as i32 - l2_w as i32) / 2).max(margin_x);
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    secondary_text_color,
+                    l2_x,
+                    y_line2,
+                    scale_sub,
+                    &font,
+                    &line2,
+                );
+            }
+        } else {
+            if !left_title.is_empty() {
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    text_color,
+                    margin_x,
+                    y_line1,
+                    scale_title,
+                    &font,
+                    &left_title,
+                );
+            }
+            if !left_sub.is_empty() {
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    secondary_text_color,
+                    margin_x,
+                    y_line2,
+                    scale_sub,
+                    &font,
+                    &left_sub,
+                );
+            }
+
+            if !right_title.is_empty() {
+                let (rw, _) = imageproc::drawing::text_size(scale_title, &font, &right_title);
+                let rx = (width as i32 - margin_x - rw as i32).max(margin_x);
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    text_color,
+                    rx,
+                    y_line1,
+                    scale_title,
+                    &font,
+                    &right_title,
+                );
+            }
+            if !right_sub.is_empty() {
+                let (rw, _) = imageproc::drawing::text_size(scale_sub, &font, &right_sub);
+                let rx = (width as i32 - margin_x - rw as i32).max(margin_x);
+                imageproc::drawing::draw_text_mut(
+                    &mut output_buf,
+                    secondary_text_color,
+                    rx,
+                    y_line2,
+                    scale_sub,
+                    &font,
+                    &right_sub,
+                );
+            }
+        }
+
+        DynamicImage::ImageRgba8(output_buf)
+    }
+}
