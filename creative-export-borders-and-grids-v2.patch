+        u8::from_str_radix(&expanded[start..start + 2], 16)
+            .map_err(|_| "Border color must be a valid hex color such as #ffffff.".to_string())
+    };
+    Ok(Rgba([channel(0)?, channel(2)?, channel(4)?, 255]))
+}
+
+#[allow(dead_code)]
+fn border_dimensions(width: u32, height: u32, size: f32) -> Result<(u32, u32, u32, u32), String> {
+    if !size.is_finite() || size < 0.0 {
+        return Err("Border size must be a non-negative number.".to_string());
+    }
+    if size == 0.0 {
+        return Ok((0, 0, width, height));
+    }
+    let horizontal = ((width as f32 * size / 100.0).round() as u32).max(1);
+    let vertical = ((height as f32 * size / 100.0).round() as u32).max(1);
+    let output_width = width.checked_add(horizontal.saturating_mul(2)).ok_or("Border makes image too wide.")?;
+    let output_height = height.checked_add(vertical.saturating_mul(2)).ok_or("Border makes image too tall.")?;
+    Ok((horizontal, vertical, output_width, output_height))
+}
+
+fn calculate_border_margins(
+    width: u32,
+    height: u32,
+    border_settings: &BorderSettings,
+) -> Result<(u32, u32, u32, u32, u32, u32), String> {
+    let left_pct = border_settings.left_size.unwrap_or(border_settings.size);
+    let right_pct = border_settings.right_size.unwrap_or(border_settings.size);
+    let top_pct = border_settings.top_size.unwrap_or(border_settings.size);
+    let bottom_pct = border_settings.bottom_size.unwrap_or(border_settings.size);
+
+    for (name, val) in [("Left", left_pct), ("Right", right_pct), ("Top", top_pct), ("Bottom", bottom_pct)] {
+        if !val.is_finite() || val < 0.0 {
+            return Err(format!("{name} border size must be a non-negative number."));
+        }
+    }
+
+    let mut pad_left = if left_pct > 0.0 { ((width as f32 * left_pct / 100.0).round() as u32).max(1) } else { 0 };
+    let mut pad_right = if right_pct > 0.0 { ((width as f32 * right_pct / 100.0).round() as u32).max(1) } else { 0 };
+    let mut pad_top = if top_pct > 0.0 { ((height as f32 * top_pct / 100.0).round() as u32).max(1) } else { 0 };
+    let mut pad_bottom = if bottom_pct > 0.0 { ((height as f32 * bottom_pct / 100.0).round() as u32).max(1) } else { 0 };
+
+    if let Some(film) = &border_settings.film_strip {
+        if film.enabled {
+            let film_tb = ((height as f32 * top_pct.max(5.0) / 100.0).round() as u32).max(28);
+            let film_lr = ((width as f32 * left_pct.max(2.5) / 100.0).round() as u32).max(12);
+            pad_top = pad_top.max(film_tb);
+            pad_bottom = pad_bottom.max(film_tb);
+            pad_left = pad_left.max(film_lr);
+            pad_right = pad_right.max(film_lr);
+        }
+    }
+
+    if let Some(target_ratio) = border_settings.target_aspect_ratio {
+        if target_ratio > 0.0 {
+            let base_w = width + pad_left + pad_right;
+            let base_h = height + pad_top + pad_bottom;
+            let current_ratio = base_w as f32 / base_h as f32;
+
+            if current_ratio < target_ratio {
+                let needed_total_h = (base_w as f32 / target_ratio).round() as u32;
+                if needed_total_h > base_h {
+                    let add_y = needed_total_h - base_h;
+                    pad_top += add_y / 2;
+                    pad_bottom += add_y - (add_y / 2);
+                } else {
+                    let needed_total_w = (base_h as f32 * target_ratio).round() as u32;
+                    let add_x = needed_total_w.saturating_sub(base_w);
+                    pad_left += add_x / 2;
+                    pad_right += add_x - (add_x / 2);
+                }
+            }
+        }
+    }
+
+    let output_width = width
+        .checked_add(pad_left.saturating_add(pad_right))
+        .ok_or("Border makes image too wide.")?;
+    let output_height = height
+        .checked_add(pad_top.saturating_add(pad_bottom))
+        .ok_or("Border makes image too tall.")?;
+
+    Ok((pad_left, pad_right, pad_top, pad_bottom, output_width, output_height))
+}
+
+
+fn draw_filled_rect(
+    buffer: &mut ImageBuffer<Rgba<u8>, Vec<u8>>,
+    x0: i32,
+    y0: i32,
+    x1: i32,
+    y1: i32,
+    color: Rgba<u8>,
+    opacity: f32,
+) {
+    let (buf_w, buf_h) = buffer.dimensions();
+    let min_x = x0.clamp(0, buf_w as i32) as u32;
+    let max_x = x1.clamp(0, buf_w as i32) as u32;
+    let min_y = y0.clamp(0, buf_h as i32) as u32;
+    let max_y = y1.clamp(0, buf_h as i32) as u32;
+
+    if min_x >= max_x || min_y >= max_y {
+        return;
+    }
+
+    if opacity >= 0.999 {
+        for y in min_y..max_y {
+            for x in min_x..max_x {
+                buffer.put_pixel(x, y, color);
+            }
+        }
+    } else {
+        let alpha = opacity.clamp(0.0, 1.0);
+        let inv_alpha = 1.0 - alpha;
+        for y in min_y..max_y {
+            for x in min_x..max_x {
+                let p = buffer.get_pixel(x, y);
+                let r = (color[0] as f32 * alpha + p[0] as f32 * inv_alpha).round() as u8;
+                let g = (color[1] as f32 * alpha + p[1] as f32 * inv_alpha).round() as u8;
+                let b = (color[2] as f32 * alpha + p[2] as f32 * inv_alpha).round() as u8;
+                buffer.put_pixel(x, y, Rgba([r, g, b, 255]));
+            }
+        }
+    }
+}
+
+fn draw_rect_outline(
+    buffer: &mut ImageBuffer<Rgba<u8>, Vec<u8>>,
+    x0: i32,
+    y0: i32,
+    x1: i32,
+    y1: i32,
+    thickness: u32,
+    color: Rgba<u8>,
+    opacity: f32,
+) {
+    let t = thickness as i32;
+    draw_filled_rect(buffer, x0, y0, x1, y0 + t, color, opacity);
+    draw_filled_rect(buffer, x0, y1 - t, x1, y1, color, opacity);
+    draw_filled_rect(buffer, x0, y0, x0 + t, y1, color, opacity);
+    draw_filled_rect(buffer, x1 - t, y0, x1, y1, color, opacity);
+}
+
+fn apply_border(image: DynamicImage, border_settings: &BorderSettings) -> Result<DynamicImage, String> {
+    let (width, height) = image.dimensions();
+    let (pad_left, pad_right, pad_top, pad_bottom, output_width, output_height) =
+        calculate_border_margins(width, height, border_settings)?;
+
+    let mut bordered = if pad_left > 0 || pad_right > 0 || pad_top > 0 || pad_bottom > 0 {
+        let mut buf = ImageBuffer::from_pixel(output_width, output_height, parse_border_color(&border_settings.color)?);
+        imageops::overlay(&mut buf, &image.to_rgba8(), pad_left as i64, pad_top as i64);
+        buf
+    } else {
+        image.to_rgba8()
+    };
+
+    // 1. Inset Keyline
+    if let Some(keyline) = &border_settings.keyline {
+        if keyline.enabled {
+            let keyline_color = parse_border_color(&keyline.color)?;
+            let thickness = ((width.min(height) as f32 * keyline.size / 100.0).round() as u32).max(1);
+            let inset = ((width.min(height) as f32 * keyline.inset / 100.0).round() as i32).max(0);
+
+            let kx0 = (pad_left as i32) - inset;
+            let ky0 = (pad_top as i32) - inset;
+            let kx1 = (pad_left + width) as i32 + inset;
+            let ky1 = (pad_top + height) as i32 + inset;
+
+            draw_rect_outline(&mut bordered, kx0, ky0, kx1, ky1, thickness, keyline_color, 1.0);
+        }
+    }
+
+    // 2. Composition Grid Overlay
+    if let Some(grid) = &border_settings.grid_overlay {
+        if grid.enabled && grid.columns > 1 && grid.rows > 1 {
+            let grid_color = parse_border_color(&grid.color)?;
+            let opacity = (grid.opacity / 100.0).clamp(0.0, 1.0);
+            let thickness = ((width.min(height) as f32 * grid.size / 100.0).round() as u32).max(1);
+
+            let img_x0 = pad_left as i32;
+            let img_y0 = pad_top as i32;
+            let img_x1 = (pad_left + width) as i32;
+            let img_y1 = (pad_top + height) as i32;
+
+            for col in 1..grid.columns {
+                let gx = img_x0 + ((width as f32 * col as f32 / grid.columns as f32).round() as i32);
+                let half_t = (thickness / 2) as i32;
+                draw_filled_rect(&mut bordered, gx - half_t, img_y0, gx - half_t + (thickness as i32), img_y1, grid_color, opacity);
+            }
+
+            for row in 1..grid.rows {
+                let gy = img_y0 + ((height as f32 * row as f32 / grid.rows as f32).round() as i32);
+                let half_t = (thickness / 2) as i32;
+                draw_filled_rect(&mut bordered, img_x0, gy - half_t, img_x1, gy - half_t + (thickness as i32), grid_color, opacity);
+            }
+        }
+    }
+
+    // 3. Film Strip Sprocket Holes & Markings
+    if let Some(film) = &border_settings.film_strip {
+        if film.enabled {
+            let show_sprockets = film.show_sprockets.unwrap_or(true);
+            let is_35mm = film.format.as_deref().unwrap_or("35mm") == "35mm";
+
+            if is_35mm && show_sprockets && pad_top >= 8 && pad_bottom >= 8 {
+                let count = (output_width / 36).max(4);
+                let step = output_width as f32 / count as f32;
+                let sw = (step * 0.5).round().max(4.0) as i32;
+                let sh = ((pad_top as f32 * 0.42).round() as i32).max(6);
+                let sy_top = ((pad_top as i32 - sh) / 2).max(2);
+                let sy_bot = (output_height as i32 - pad_bottom as i32) + ((pad_bottom as i32 - sh) / 2);
+                let sprocket_color = Rgba([0, 0, 0, 255]);
+                let border_color = Rgba([39, 39, 42, 255]);
+
+                for i in 0..count {
+                    let sx = (i as f32 * step + step * 0.25).round() as i32;
+                    draw_filled_rect(&mut bordered, sx, sy_top, sx + sw, sy_top + sh, sprocket_color, 1.0);
+                    draw_rect_outline(&mut bordered, sx, sy_top, sx + sw, sy_top + sh, 1, border_color, 0.6);
+
+                    draw_filled_rect(&mut bordered, sx, sy_bot, sx + sw, sy_bot + sh, sprocket_color, 1.0);
+                    draw_rect_outline(&mut bordered, sx, sy_bot, sx + sw, sy_bot + sh, 1, border_color, 0.6);
+                }
+            }
+
+            if let Some(font) = crate::default_font::get_default_font() {
+                let font_px = ((output_width as f32 / 75.0).clamp(10.0, 36.0)).round();
+                let scale = ab_glyph::PxScale::from(font_px);
+                let text_color = Rgba([161, 161, 170, 255]);
+
+                let top_left = film.edge_markings.as_deref().unwrap_or("36 EXP  •  35MM");
+                let top_str = format!("▲ {}", top_left);
+                let text_y_top = (pad_top as f32 * 0.75).round() as i32;
+                imageproc::drawing::draw_text_mut(
+                    &mut bordered,
+                    text_color,
+                    (pad_left as i32 + 8).max(4),
+                    text_y_top,
+                    scale,
+                    &font,
+                    &top_str,
+                );
+
+                let iso_text = "ISO 400";
+                let (iso_w, _) = imageproc::drawing::text_size(scale, &font, iso_text);
+                let iso_x = (output_width as i32 - pad_right as i32 - iso_w as i32 - 8).max(0);
+                imageproc::drawing::draw_text_mut(
+                    &mut bordered,
+                    text_color,
+                    iso_x,
+                    text_y_top,
+                    scale,
+                    &font,
+                    iso_text,
+                );
+
+                let frame_num = film.frame_number.as_deref().unwrap_or("01");
+                let bot_str = format!("FRAME {}  •  ▶▶", frame_num);
+                let text_y_bot = (output_height as i32 - (pad_bottom as f32 * 0.35).round() as i32)
+                    .min(output_height as i32 - font_px as i32 - 2);
+                imageproc::drawing::draw_text_mut(
+                    &mut bordered,
+                    text_color,
+                    (pad_left as i32 + 8).max(4),
+                    text_y_bot,
+                    scale,
+                    &font,
+                    &bot_str,
+                );
+            }
+        }
+    }
+
+    // 4. Retro Digital Timestamp
+    if let Some(ts) = &border_settings.timestamp {
+        if ts.enabled {
+            if let Some(font) = crate::default_font::get_default_font() {
+                let is_green = ts.style.as_deref() == Some("digital_green");
+                let ts_color = if is_green {
+                    Rgba([34, 197, 94, 255])
+                } else {
+                    Rgba([255, 140, 0, 255])
+                };
+                let shadow_color = if is_green {
+                    Rgba([0, 40, 0, 200])
+                } else {
+                    Rgba([40, 15, 0, 200])
+                };
+
+                let font_px = ((width as f32 / 52.0).clamp(13.0, 48.0)).round();
+                let scale = ab_glyph::PxScale::from(font_px);
+                let date_text = ts.text.as_deref().unwrap_or("'26 09 19");
+                let (tw, th) = imageproc::drawing::text_size(scale, &font, date_text);
+
+                let margin_r = (font_px * 0.8).round() as i32;
+                let margin_b = (font_px * 0.5).round() as i32;
+                let tx = ((pad_left + width) as i32 - tw as i32 - margin_r).max(pad_left as i32);
+                let ty = ((pad_top + height) as i32 - th as i32 - margin_b).max(pad_top as i32);
+
+                imageproc::drawing::draw_text_mut(&mut bordered, shadow_color, tx + 1, ty + 1, scale, &font, date_text);
+                imageproc::drawing::draw_text_mut(&mut bordered, ts_color, tx, ty, scale, &font, date_text);
+            }
+        }
+    }
+
+    Ok(DynamicImage::ImageRgba8(bordered))
+}
+
+fn composite_photo_collage(
+    images: &[DynamicImage],
+    collage_settings: &CollageGridSettings,
+    border_settings: Option<&BorderSettings>,
+) -> Result<DynamicImage, String> {
+    if images.is_empty() {
+        return Err("No images provided for collage".to_string());
+    }
+
+    let cols = collage_settings.columns.max(1);
+    let rows = collage_settings.rows.max(1);
+
+    let (first_w, first_h) = images[0].dimensions();
+    let cell_w = first_w.max(100);
+    let cell_h = first_h.max(100);
+
+    let gutter_px = if cols > 1 || rows > 1 {
+        (cell_w as f32 * collage_settings.gutter / 100.0).round() as u32
+    } else {
+        0
+    };
+
+    let inner_w = cols * cell_w + (cols.saturating_sub(1)) * gutter_px;
+    let inner_h = rows * cell_h + (rows.saturating_sub(1)) * gutter_px;
+
+    let bg_color_str = collage_settings.background_color.as_deref().unwrap_or("#ffffff");
+    let bg_color = parse_border_color(bg_color_str)?;
+
+    let mut master = ImageBuffer::from_pixel(inner_w, inner_h, bg_color);
+
+    for (idx, img) in images.iter().enumerate() {
+        if idx >= (cols * rows) as usize {
+            break;
+        }
+        let col = (idx as u32) % cols;
+        let row = (idx as u32) / cols;
+
+        let cell_x = col * (cell_w + gutter_px);
+        let cell_y = row * (cell_h + gutter_px);
+
+        let (iw, ih) = img.dimensions();
+        let target_img = if collage_settings.cell_fit == "fill" {
+            let scale_x = cell_w as f32 / iw as f32;
+            let scale_y = cell_h as f32 / ih as f32;
+            let scale = scale_x.max(scale_y);
+            let scaled_w = (iw as f32 * scale).round() as u32;
+            let scaled_h = (ih as f32 * scale).round() as u32;
+
+            let scaled = img.resize_exact(scaled_w, scaled_h, imageops::FilterType::Lanczos3);
+            let crop_x = (scaled_w.saturating_sub(cell_w)) / 2;
+            let crop_y = (scaled_h.saturating_sub(cell_h)) / 2;
+            scaled.crop_imm(crop_x, crop_y, cell_w, cell_h)
+        } else {
+            img.resize(cell_w, cell_h, imageops::FilterType::Lanczos3)
+        };
+
+        let (tw, th) = target_img.dimensions();
+        let paste_x = cell_x + (cell_w.saturating_sub(tw)) / 2;
+        let paste_y = cell_y + (cell_h.saturating_sub(th)) / 2;
+
+        imageops::overlay(&mut master, &target_img.to_rgba8(), paste_x as i64, paste_y as i64);
+    }
+
+    let mut result = DynamicImage::ImageRgba8(master);
+
+    if let Some(border) = border_settings {
+        result = apply_border(result, border)?;
+    }
+
+    Ok(result)
+}
+
+fn slice_into_tiles(
+    image: &DynamicImage,
+    tile_settings: &TileSplitSettings,
+    border_settings: Option<&BorderSettings>,
+) -> Result<Vec<DynamicImage>, String> {
+    let (width, height) = image.dimensions();
+    let cols = tile_settings.columns.max(1);
+    let rows = tile_settings.rows.max(1);
+
+    let tile_w = width / cols;
+    let tile_h = height / rows;
+
+    if tile_w == 0 || tile_h == 0 {
+        return Err("Image too small to split into the requested number of tiles".to_string());
+    }
+
+    let mut tiles = Vec::with_capacity((cols * rows) as usize);
+
+    for r in 0..rows {
+        for c in 0..cols {
+            let tx = c * tile_w;
+            let ty = r * tile_h;
+            let mut tile = image.crop_imm(tx, ty, tile_w, tile_h);
+
+            if tile_settings.border_each_tile {
+                if let Some(border) = border_settings {
+                    tile = apply_border(tile, border)?;
+                }
+            }
+            tiles.push(tile);
+        }
+    }
+
+    Ok(tiles)
 }
 
