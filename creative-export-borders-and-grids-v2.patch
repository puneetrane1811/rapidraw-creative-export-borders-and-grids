+import React, { useState, useEffect } from 'react';
+import Text from '../../ui/Text';
+import { TextVariants } from '../../../types/typography';
+
+export interface SectionProps {
+  children: any;
+  title: string;
+  className?: string;
+}
+
+export function Section({ title, children, className }: SectionProps) {
+  return (
+    <div className={className}>
+      <Text variant={TextVariants.heading} className="mb-2">
+        {title}
+      </Text>
+      <div className="space-y-2">{children}</div>
+    </div>
+  );
+}
+
+export function GridNumberInput({
+  value,
+  min,
+  max,
+  disabled,
+  onChange,
+  className,
+}: {
+  value: number;
+  min: number;
+  max: number;
+  disabled?: boolean;
+  onChange: (val: number) => void;
+  className?: string;
+}) {
+  const [localVal, setLocalVal] = useState<string>(String(value || min));
+
+  useEffect(() => {
+    setLocalVal(String(value || min));
+  }, [value, min]);
+
+  return (
+    <input
+      type="number"
+      min={min}
+      max={max}
+      value={localVal}
+      disabled={disabled}
+      onChange={(e) => {
+        const raw = e.target.value;
+        setLocalVal(raw);
+        if (raw === '') return;
+        const num = parseInt(raw, 10);
+        if (!isNaN(num)) {
+          const clamped = Math.min(max, Math.max(min, num));
+          onChange(clamped);
+        }
+      }}
+      onBlur={() => {
+        const num = parseInt(localVal, 10);
+        if (isNaN(num) || num < min) {
+          setLocalVal(String(min));
+          onChange(min);
+        } else if (num > max) {
+          setLocalVal(String(max));
+          onChange(max);
+        } else {
+          setLocalVal(String(num));
+          onChange(num);
+        }
+      }}
+      className={
+        className ||
+        'w-full bg-surface border border-surface rounded-md p-2 text-sm text-text-primary focus:ring-accent focus:border-accent disabled:opacity-50 text-center font-medium'
+      }
+    />
+  );
+}
+
+export const formatBytes = (bytes: number, t: any, decimals = 2) => {
+  if (bytes === 0) return `0 ${t('export.bytes.bytes')}`;
+  const k = 1024;
+  const dm = decimals < 0 ? 0 : decimals;
+  const sizes = [
+    t('export.bytes.bytes'),
+    t('export.bytes.kb'),
+    t('export.bytes.mb'),
+    t('export.bytes.gb'),
+    t('export.bytes.tb'),
+  ];
+  const i = Math.floor(Math.log(bytes) / Math.log(k));
+  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
+};
+
+export function formatExifSummary(exif: any) {
+  if (!exif) {
+    return {
+      camera: 'SONY ILCE-7M4',
+      lens: 'FE 24-70mm F2.8 GM II',
+      settings: '50mm • ƒ/2.8 • 1/500s • ISO 100',
+      date: '2026-09-18',
+    };
+  }
+  const make = exif.Make ? String(exif.Make).trim() : '';
+  let model = exif.Model ? String(exif.Model).trim() : '';
+  let camera = model;
+  if (make && !model.toLowerCase().startsWith(make.toLowerCase())) {
+    camera = `${make} ${model}`;
+  }
+  if (!camera) camera = 'CAMERA';
+
+  const lens = exif.LensModel ? String(exif.LensModel).trim() : '';
+
+  const parts: string[] = [];
+  const focal = exif.FocalLengthIn35mmFilm || exif.FocalLength;
+  if (focal) {
+    const num = typeof focal === 'number' ? focal : parseFloat(focal);
+    if (!isNaN(num) && num > 0) parts.push(`${Math.round(num)}mm`);
+  }
+  const fnum = exif.FNumber;
+  if (fnum) {
+    const num = typeof fnum === 'number' ? fnum : parseFloat(fnum);
+    if (!isNaN(num) && num > 0) parts.push(`ƒ/${num.toFixed(1).replace('.0', '')}`);
+  }
+  const exp = exif.ExposureTime;
+  if (exp) {
+    const num = typeof exp === 'number' ? exp : parseFloat(exp);
+    if (!isNaN(num) && num > 0) {
+      if (num < 1) {
+        parts.push(`1/${Math.round(1 / num)}s`);
+      } else {
+        parts.push(`${num.toFixed(1).replace('.0', '')}s`);
+      }
+    }
+  }
+  const iso = exif.PhotographicSensitivity || exif.ISOSpeedRatings;
+  if (iso) {
+    parts.push(`ISO ${iso}`);
+  }
+  const settings = parts.join(' • ');
+
+  let date = '';
+  if (exif.DateTimeOriginal) {
+    const dStr = String(exif.DateTimeOriginal).split(' ')[0];
+    date = dStr ? dStr.replace(/:/g, '-') : '';
+  }
+  return { camera, lens, settings, date };
+}
