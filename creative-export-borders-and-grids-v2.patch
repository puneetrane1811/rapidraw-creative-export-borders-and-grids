+export interface ExportStateStore extends CreativeExportSettings {
+  // Standard Export Parameters
+  fileFormat: string;
+  jpegQuality: number;
+  tiffBitDepth: TiffBitDepth;
+  enableResize: boolean;
+  resizeMode: string;
+  resizeValue: number;
+  dontEnlarge: boolean;
+  keepMetadata: boolean;
+  preserveTimestamps: boolean;
+  stripGps: boolean;
+  exportMasks: boolean;
+  preserveFolders: boolean;
+  filenameTemplate: string;
+  destinationType: string;
+  subfolder: string;
+
+  // Moved from Creative to Standard Export
+  enableGridTools: boolean;
+  enableGridOverlay: boolean;
+  gridOverlayRows: number;
+  gridOverlayCols: number;
+  gridOverlayColor: string;
+  gridOverlayOpacity: number;
+  gridOverlaySize: number;
+
+  enableCollageGrid: boolean;
+  collageColumns: number;
+  collageRows: number;
+  collageGutter: number;
+  collageCellFit: 'fit' | 'fill';
+
+  enableTileSplit: boolean;
+  tileSplitColumns: number;
+  tileSplitRows: number;
+  tileBorderEachTile: boolean;
+
+  // View & Proofing State
+  showExportProofing: boolean;
+  currentImagePath: string | null;
+
+  // Per-Image Retention
+  imageCreativeSettings: Record<string, Partial<CreativeExportSettings>>;
+
+  // Creative Presets
+  creativePresets: CreativeExportPreset[];
+  activeCreativePresetId: string | null;
+
+  // Setters & Actions
+  setStandardSetting: <K extends keyof ExportStateStore>(key: K, value: ExportStateStore[K]) => void;
+  setCreativeSetting: <K extends keyof CreativeExportSettings>(key: K, value: CreativeExportSettings[K]) => void;
+  setCreativeSettingsBatch: (values: Partial<CreativeExportSettings>) => void;
+  setShowExportProofing: (show: boolean) => void;
+
+  // Per-image workflow
+  saveSettingsForImage: (path: string) => void;
+  loadSettingsForImage: (path: string) => void;
+
+  // Granular individual reverts
+  resetSection: (section: 'framing' | 'polaroid' | 'keyline' | 'watermark' | 'exifBadge' | 'film' | 'analog' | 'cinematic') => void;
+  resetAllCreativeFilters: () => void;
+
+  // Creative Presets Management
+  saveCreativePreset: (name: string) => CreativeExportPreset;
+  applyCreativePreset: (preset: CreativeExportPreset) => void;
+  applyCreativePresetToPaths: (preset: CreativeExportPreset, paths: string[]) => void;
+  deleteCreativePreset: (id: string) => void;
+
+  // Standard Presets Management
+  applyExportPreset: (preset: ExportPreset) => void;
+  getCurrentSettingsObject: () => Omit<ExportPreset, 'id' | 'name'>;
+}
+
+export const useExportStore = create<ExportStateStore>((set, get) => {
+  const initialImageCreativeSettings = loadPersistedCreativeSettings();
+  const initialCreativePresets = loadPersistedCreativePresets();
+  const initialGridSettings = loadPersistedGridSettings();
+
+  return {
+    // Initial Standard Export State
+    fileFormat: 'jpeg',
+    jpegQuality: 90,
+    tiffBitDepth: 16,
+    enableResize: false,
+    resizeMode: 'longEdge',
+    resizeValue: 2048,
+    dontEnlarge: true,
+    keepMetadata: true,
+    preserveTimestamps: false,
+    stripGps: true,
+    exportMasks: false,
+    preserveFolders: false,
+    filenameTemplate: '{original_filename}_edited',
+    destinationType: 'customFolder',
+    subfolder: '',
+
+    // Standard Grid & Slicing Tools (Persisted)
+    ...initialGridSettings,
+
+    // Initial Creative Export State
+    ...DEFAULT_CREATIVE_SETTINGS,
+
+    // Proofing & Image Path
+    showExportProofing: false,
+    currentImagePath: null,
+
+    // Per-Image Retention Map
+    imageCreativeSettings: initialImageCreativeSettings,
+
+    // Creative Presets
+    creativePresets: initialCreativePresets,
+    activeCreativePresetId: null,
+
+    // Actions
+    setStandardSetting: (key, value) => {
+      set({ [key]: value } as any);
+      if (GRID_SETTING_KEYS.has(key as string)) {
+        savePersistedGridSettings({ [key]: value });
+      }
+    },
+
+    setCreativeSetting: (key, value) => {
+      const state = get();
+      const currentPath = state.currentImagePath;
+
+      if (currentPath) {
+        const currentSaved = state.imageCreativeSettings[currentPath] || {};
+        const updatedForPath = { ...currentSaved, [key]: value };
+        const updatedAll = { ...state.imageCreativeSettings, [currentPath]: updatedForPath };
+        savePersistedCreativeSettings(updatedAll);
+        set({ [key]: value, imageCreativeSettings: updatedAll } as any);
+      } else {
+        set({ [key]: value } as any);
+      }
+    },
+
+    setCreativeSettingsBatch: (values) => {
+      const state = get();
+      const currentPath = state.currentImagePath;
+
+      if (currentPath) {
+        const currentSaved = state.imageCreativeSettings[currentPath] || {};
+        const updatedForPath = { ...currentSaved, ...values };
+        const updatedAll = { ...state.imageCreativeSettings, [currentPath]: updatedForPath };
+        savePersistedCreativeSettings(updatedAll);
+        set({ ...values, imageCreativeSettings: updatedAll } as any);
+      } else {
+        set(values as any);
+      }
+    },
+
+    setShowExportProofing: (show) => {
+      set({ showExportProofing: show });
+    },
+
+    saveSettingsForImage: (path) => {
+      if (!path) return;
+      const state = get();
+      const currentCreative: Partial<CreativeExportSettings> = {
+        enableBorder: state.enableBorder,
+        borderSize: state.borderSize,
+        borderColor: state.borderColor,
+        enablePolaroid: state.enablePolaroid,
+        polaroidBottomMultiplier: state.polaroidBottomMultiplier,
+        enableKeyline: state.enableKeyline,
+        keylineSize: state.keylineSize,
+        keylineColor: state.keylineColor,
+        keylineInset: state.keylineInset,
+        enableWatermark: state.enableWatermark,
+        watermarkType: state.watermarkType,
+        watermarkText: state.watermarkText,
+        watermarkColor: state.watermarkColor,
+        watermarkPath: state.watermarkPath,
+        watermarkAnchor: state.watermarkAnchor,
+        watermarkScale: state.watermarkScale,
+        watermarkSpacing: state.watermarkSpacing,
+        watermarkOpacity: state.watermarkOpacity,
+        watermarkCustomPlacement: state.watermarkCustomPlacement,
+        watermarkCustomX: state.watermarkCustomX,
+        watermarkCustomY: state.watermarkCustomY,
+        enableExifBadge: state.enableExifBadge,
+        exifBadgeStyle: state.exifBadgeStyle,
+        exifBadgeAlignment: state.exifBadgeAlignment,
+        exifShowCamera: state.exifShowCamera,
+        exifShowLens: state.exifShowLens,
+        exifShowSettings: state.exifShowSettings,
+        exifShowDate: state.exifShowDate,
+        exifCustomText: state.exifCustomText,
+        exifBadgeBgColor: state.exifBadgeBgColor,
+        exifBadgeTextColor: state.exifBadgeTextColor,
+
+        // Extended photographic framing
+        activeCreativePresetId: state.activeCreativePresetId,
+        borderTopSize: state.borderTopSize,
+        borderBottomSize: state.borderBottomSize,
+        borderLeftSize: state.borderLeftSize,
+        borderRightSize: state.borderRightSize,
+        borderRadius: state.borderRadius,
+        borderShadow: state.borderShadow,
+        enableFilmStrip: state.enableFilmStrip,
+        filmFormat: state.filmFormat,
+        filmShowSprockets: state.filmShowSprockets,
+        filmShowFrameNumber: state.filmShowFrameNumber,
+        filmFrameNumber: state.filmFrameNumber,
+        filmEdgeMarkings: state.filmEdgeMarkings,
+        enableCinematicBars: state.enableCinematicBars,
+        cinematicRatio: state.cinematicRatio,
+        cinematicBarColor: state.cinematicBarColor,
+        analogEffect: state.analogEffect,
+        lightLeakIntensity: state.lightLeakIntensity,
+        fontFamily: state.fontFamily,
+        timestampStyle: state.timestampStyle,
+        archiveCatalogLayout: state.archiveCatalogLayout,
+      };
+
+      const updated = { ...state.imageCreativeSettings, [path]: currentCreative };
+      savePersistedCreativeSettings(updated);
+      set({ imageCreativeSettings: updated });
+    },
+
+    loadSettingsForImage: (path) => {
+      if (!path) return;
+      const state = get();
+      const previousPath = state.currentImagePath;
+      if (previousPath && previousPath !== path) {
+        state.saveSettingsForImage(previousPath);
+      }
+
+      const saved = state.imageCreativeSettings[path];
+      const merged = { ...DEFAULT_CREATIVE_SETTINGS, ...(saved || {}) };
+
+      set({
+        currentImagePath: path,
+        activeCreativePresetId: saved?.activeCreativePresetId ?? null,
+        ...merged,
+      });
+    },
+
+    resetSection: (section) => {
+      const state = get();
+      let resetValues: Partial<CreativeExportSettings> = {};
