+              }}
+            />
+          ) : null}
+        </div>
+      )}
+
+      {/* 7. Composition Grid Overlay (Standard Export) */}
+      {isGridOverlayActive && (
+        <svg
+          className="absolute inset-0 pointer-events-none"
+          style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
+        >
+          {Array.from({ length: gridOverlayCols - 1 }).map((_, i) => {
+            const x = ((i + 1) / gridOverlayCols) * imageWidth;
+            return (
+              <line
+                key={`v-grid-${i}`}
+                x1={x}
+                y1={0}
+                x2={x}
+                y2={imageHeight}
+                stroke={gridOverlayColor || '#ffffff'}
+                strokeWidth={gridOverlaySize || 1}
+                strokeOpacity={gridOverlayOpacity / 100}
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+          {Array.from({ length: gridOverlayRows - 1 }).map((_, i) => {
+            const y = ((i + 1) / gridOverlayRows) * imageHeight;
+            return (
+              <line
+                key={`h-grid-${i}`}
+                x1={0}
+                y1={y}
+                x2={imageWidth}
+                y2={y}
+                stroke={gridOverlayColor || '#ffffff'}
+                strokeWidth={gridOverlaySize || 1}
+                strokeOpacity={gridOverlayOpacity / 100}
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+        </svg>
+      )}
+
+      {/* 8. Multi-Tile Splitter Slice Guides (Standard Export) */}
+      {isTileSplitActive && (
+        <svg
+          className="absolute inset-0 pointer-events-none"
+          style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
+        >
+          {Array.from({ length: tileSplitColumns - 1 }).map((_, i) => {
+            const x = ((i + 1) / tileSplitColumns) * imageWidth;
+            return (
+              <line
+                key={`tile-v-${i}`}
+                x1={x}
+                y1={0}
+                x2={x}
+                y2={imageHeight}
+                stroke="#38bdf8"
+                strokeWidth="1.5"
+                strokeDasharray="6 4"
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+          {Array.from({ length: tileSplitRows - 1 }).map((_, i) => {
+            const y = ((i + 1) / tileSplitRows) * imageHeight;
+            return (
+              <line
+                key={`tile-h-${i}`}
+                x1={0}
+                y1={y}
+                x2={imageWidth}
+                y2={y}
+                stroke="#38bdf8"
+                strokeWidth="1.5"
+                strokeDasharray="6 4"
+                style={{ vectorEffect: 'non-scaling-stroke' }}
+              />
+            );
+          })}
+        </svg>
+      )}
+    </div>
+  );
+}
