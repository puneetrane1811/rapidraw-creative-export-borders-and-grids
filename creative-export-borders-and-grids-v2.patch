+export interface GridExportSettings {
+  enableCollageGrid: boolean;
+  collageColumns: number;
+  collageRows: number;
+  collageGutter: number;
+  collageCellFit: 'fit' | 'fill';
+  enableGridTools: boolean;
+  enableTileSplit: boolean;
+  tileSplitColumns: number;
+  tileSplitRows: number;
+  tileBorderEachTile: boolean;
+  enableGridOverlay: boolean;
+  gridOverlayRows: number;
+  gridOverlayCols: number;
+  gridOverlayColor: string;
+  gridOverlayOpacity: number;
+  gridOverlaySize: number;
+}
+
+export const DEFAULT_GRID_SETTINGS: GridExportSettings = {
+  enableCollageGrid: false,
+  collageColumns: 2,
+  collageRows: 2,
+  collageGutter: 1.0,
+  collageCellFit: 'fit',
+  enableGridTools: false,
+  enableTileSplit: false,
+  tileSplitColumns: 3,
+  tileSplitRows: 1,
+  tileBorderEachTile: false,
+  enableGridOverlay: false,
+  gridOverlayRows: 3,
+  gridOverlayCols: 3,
+  gridOverlayColor: '#ffffff',
+  gridOverlayOpacity: 50,
+  gridOverlaySize: 1,
+};
+
+const LOCAL_STORAGE_GRID_SETTINGS_KEY = 'rapidraw_export_grid_settings';
+
+const GRID_SETTING_KEYS = new Set([
+  'enableCollageGrid',
+  'collageColumns',
+  'collageRows',
+  'collageGutter',
+  'collageCellFit',
+  'enableGridTools',
+  'enableTileSplit',
+  'tileSplitColumns',
+  'tileSplitRows',
+  'tileBorderEachTile',
+  'enableGridOverlay',
+  'gridOverlayRows',
+  'gridOverlayCols',
+  'gridOverlayColor',
+  'gridOverlayOpacity',
+  'gridOverlaySize',
+]);
+
+const loadPersistedGridSettings = (): GridExportSettings => {
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_GRID_SETTINGS_KEY);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      return {
+        ...DEFAULT_GRID_SETTINGS,
+        ...parsed,
+        collageColumns:
+          typeof parsed.collageColumns === 'number' && parsed.collageColumns >= 1
+            ? parsed.collageColumns
+            : DEFAULT_GRID_SETTINGS.collageColumns,
+        collageRows:
+          typeof parsed.collageRows === 'number' && parsed.collageRows >= 1
+            ? parsed.collageRows
+            : DEFAULT_GRID_SETTINGS.collageRows,
+        collageGutter:
+          typeof parsed.collageGutter === 'number' && parsed.collageGutter >= 0
+            ? parsed.collageGutter
+            : DEFAULT_GRID_SETTINGS.collageGutter,
+        collageCellFit: parsed.collageCellFit === 'fill' ? 'fill' : 'fit',
+        enableGridTools: Boolean(parsed.enableGridTools),
+      };
+    }
+  } catch (err) {
+    console.error('Failed to load grid settings from localStorage:', err);
+  }
+  return DEFAULT_GRID_SETTINGS;
+};
+
+const savePersistedGridSettings = (settings: Partial<GridExportSettings>) => {
+  try {
+    const current = loadPersistedGridSettings();
+    const updated = { ...current, ...settings };
+    localStorage.setItem(LOCAL_STORAGE_GRID_SETTINGS_KEY, JSON.stringify(updated));
+  } catch (err) {
+    console.error('Failed to save grid settings to localStorage:', err);
+  }
+};
