+fn parse_border_color(color: &str) -> Result<Rgba<u8>, String> {
+    let hex = color.trim().strip_prefix('#').unwrap_or(color.trim());
+    let expanded = match hex.len() {
+        3 => hex.chars().flat_map(|c| [c, c]).collect::<String>(),
+        6 => hex.to_owned(),
+        _ => return Err("Border color must be a hex color such as #ffffff.".to_string()),
+    };
+
+    let channel = |start| {
+        u8::from_str_radix(&expanded[start..start + 2], 16)
+            .map_err(|_| "Border color must be a valid hex color such as #ffffff.".to_string())
+    };
+    Ok(Rgba([channel(0)?, channel(2)?, channel(4)?, 255]))
+}
+
+fn border_dimensions(width: u32, height: u32, size: f32) -> Result<(u32, u32, u32, u32), String> {
+    if !size.is_finite() || size < 0.0 {
+        return Err("Border size must be a non-negative number.".to_string());
+    }
+    if size == 0.0 {
+        return Ok((0, 0, width, height));
+    }
+    let horizontal = ((width as f32 * size / 100.0).round() as u32).max(1);
+    let vertical = ((height as f32 * size / 100.0).round() as u32).max(1);
+    let output_width = width.checked_add(horizontal.saturating_mul(2)).ok_or("Border makes image too wide.")?;
+    let output_height = height.checked_add(vertical.saturating_mul(2)).ok_or("Border makes image too tall.")?;
+    Ok((horizontal, vertical, output_width, output_height))
+}
+
+fn draw_filled_rect(
+    buffer: &mut ImageBuffer<Rgba<u8>, Vec<u8>>,
+    x0: i32,
+    y0: i32,
+    x1: i32,
+    y1: i32,
+    color: Rgba<u8>,
+    opacity: f32,
+) {
+    let (buf_w, buf_h) = buffer.dimensions();
+    let min_x = x0.clamp(0, buf_w as i32) as u32;
+    let max_x = x1.clamp(0, buf_w as i32) as u32;
+    let min_y = y0.clamp(0, buf_h as i32) as u32;
+    let max_y = y1.clamp(0, buf_h as i32) as u32;
+
+    if min_x >= max_x || min_y >= max_y {
+        return;
+    }
+
+    if opacity >= 0.999 {
+        for y in min_y..max_y {
+            for x in min_x..max_x {
+                buffer.put_pixel(x, y, color);
+            }
+        }
+    } else {
+        let alpha = opacity.clamp(0.0, 1.0);
+        let inv_alpha = 1.0 - alpha;
+        for y in min_y..max_y {
+            for x in min_x..max_x {
+                let p = buffer.get_pixel(x, y);
+                let r = (color[0] as f32 * alpha + p[0] as f32 * inv_alpha).round() as u8;
+                let g = (color[1] as f32 * alpha + p[1] as f32 * inv_alpha).round() as u8;
+                let b = (color[2] as f32 * alpha + p[2] as f32 * inv_alpha).round() as u8;
+                buffer.put_pixel(x, y, Rgba([r, g, b, 255]));
+            }
+        }
+    }
+}
+
+fn draw_rect_outline(
+    buffer: &mut ImageBuffer<Rgba<u8>, Vec<u8>>,
+    x0: i32,
+    y0: i32,
+    x1: i32,
+    y1: i32,
+    thickness: u32,
+    color: Rgba<u8>,
+    opacity: f32,
+) {
+    let t = thickness as i32;
+    draw_filled_rect(buffer, x0, y0, x1, y0 + t, color, opacity);
+    draw_filled_rect(buffer, x0, y1 - t, x1, y1, color, opacity);
+    draw_filled_rect(buffer, x0, y0, x0 + t, y1, color, opacity);
+    draw_filled_rect(buffer, x1 - t, y0, x1, y1, color, opacity);
+}
+
+fn apply_border(image: DynamicImage, border_settings: &BorderSettings) -> Result<DynamicImage, String> {
+    let (width, height) = image.dimensions();
+    let (horizontal, vertical, output_width, output_height) =
+        border_dimensions(width, height, border_settings.size)?;
+
+    let mut bordered = if border_settings.size > 0.0 {
+        let mut buf = ImageBuffer::from_pixel(output_width, output_height, parse_border_color(&border_settings.color)?);
+        imageops::overlay(&mut buf, &image.to_rgba8(), horizontal as i64, vertical as i64);
+        buf
+    } else {
+        image.to_rgba8()
+    };
+
+    // 1. Inset Keyline
+    if let Some(keyline) = &border_settings.keyline {
+        if keyline.enabled {
+            let keyline_color = parse_border_color(&keyline.color)?;
+            let thickness = ((width.min(height) as f32 * keyline.size / 100.0).round() as u32).max(1);
+            let inset = ((width.min(height) as f32 * keyline.inset / 100.0).round() as i32).max(0);
+
+            let kx0 = (horizontal as i32) - inset;
+            let ky0 = (vertical as i32) - inset;
+            let kx1 = (horizontal + width) as i32 + inset;
+            let ky1 = (vertical + height) as i32 + inset;
+
+            draw_rect_outline(&mut bordered, kx0, ky0, kx1, ky1, thickness, keyline_color, 1.0);
+        }
+    }
+
+    // 2. Composition Grid Overlay
+    if let Some(grid) = &border_settings.grid_overlay {
+        if grid.enabled && grid.columns > 1 && grid.rows > 1 {
+            let grid_color = parse_border_color(&grid.color)?;
+            let opacity = (grid.opacity / 100.0).clamp(0.0, 1.0);
+            let thickness = ((width.min(height) as f32 * grid.size / 100.0).round() as u32).max(1);
+
+            let img_x0 = horizontal as i32;
+            let img_y0 = vertical as i32;
+            let img_x1 = (horizontal + width) as i32;
+            let img_y1 = (vertical + height) as i32;
+
+            for col in 1..grid.columns {
+                let gx = img_x0 + ((width as f32 * col as f32 / grid.columns as f32).round() as i32);
+                let half_t = (thickness / 2) as i32;
+                draw_filled_rect(&mut bordered, gx - half_t, img_y0, gx - half_t + (thickness as i32), img_y1, grid_color, opacity);
+            }
+
+            for row in 1..grid.rows {
+                let gy = img_y0 + ((height as f32 * row as f32 / grid.rows as f32).round() as i32);
+                let half_t = (thickness / 2) as i32;
+                draw_filled_rect(&mut bordered, img_x0, gy - half_t, img_x1, gy - half_t + (thickness as i32), grid_color, opacity);
+            }
+        }
+    }
+
+    Ok(DynamicImage::ImageRgba8(bordered))
+}
+
+fn composite_photo_collage(
+    images: &[DynamicImage],
+    collage_settings: &CollageGridSettings,
+    border_settings: Option<&BorderSettings>,
+) -> Result<DynamicImage, String> {
+    if images.is_empty() {
+        return Err("No images provided for collage".to_string());
+    }
+
+    let cols = collage_settings.columns.max(1);
+    let rows = collage_settings.rows.max(1);
+
+    let (first_w, first_h) = images[0].dimensions();
+    let cell_w = first_w.max(100);
+    let cell_h = first_h.max(100);
+
+    let gutter_px = if cols > 1 || rows > 1 {
+        (cell_w as f32 * collage_settings.gutter / 100.0).round() as u32
+    } else {
+        0
+    };
+
+    let inner_w = cols * cell_w + (cols.saturating_sub(1)) * gutter_px;
+    let inner_h = rows * cell_h + (rows.saturating_sub(1)) * gutter_px;
+
+    let bg_color_str = collage_settings.background_color.as_deref().unwrap_or("#ffffff");
+    let bg_color = parse_border_color(bg_color_str)?;
+
+    let mut master = ImageBuffer::from_pixel(inner_w, inner_h, bg_color);
+
+    for (idx, img) in images.iter().enumerate() {
+        if idx >= (cols * rows) as usize {
+            break;
+        }
+        let col = (idx as u32) % cols;
+        let row = (idx as u32) / cols;
+
+        let cell_x = col * (cell_w + gutter_px);
+        let cell_y = row * (cell_h + gutter_px);
+
+        let (iw, ih) = img.dimensions();
+        let target_img = if collage_settings.cell_fit == "fill" {
+            let scale_x = cell_w as f32 / iw as f32;
+            let scale_y = cell_h as f32 / ih as f32;
+            let scale = scale_x.max(scale_y);
+            let scaled_w = (iw as f32 * scale).round() as u32;
+            let scaled_h = (ih as f32 * scale).round() as u32;
+
+            let scaled = img.resize_exact(scaled_w, scaled_h, imageops::FilterType::Lanczos3);
+            let crop_x = (scaled_w.saturating_sub(cell_w)) / 2;
+            let crop_y = (scaled_h.saturating_sub(cell_h)) / 2;
+            scaled.crop_imm(crop_x, crop_y, cell_w, cell_h)
+        } else {
+            img.resize(cell_w, cell_h, imageops::FilterType::Lanczos3)
+        };
+
+        let (tw, th) = target_img.dimensions();
+        let paste_x = cell_x + (cell_w.saturating_sub(tw)) / 2;
+        let paste_y = cell_y + (cell_h.saturating_sub(th)) / 2;
+
+        imageops::overlay(&mut master, &target_img.to_rgba8(), paste_x as i64, paste_y as i64);
+    }
+
+    let mut result = DynamicImage::ImageRgba8(master);
+
+    if let Some(border) = border_settings {
+        result = apply_border(result, border)?;
+    }
+
+    Ok(result)
+}
+
+fn slice_into_tiles(
+    image: &DynamicImage,
+    tile_settings: &TileSplitSettings,
+    border_settings: Option<&BorderSettings>,
+) -> Result<Vec<DynamicImage>, String> {
+    let (width, height) = image.dimensions();
+    let cols = tile_settings.columns.max(1);
+    let rows = tile_settings.rows.max(1);
+
+    let tile_w = width / cols;
+    let tile_h = height / rows;
+
+    if tile_w == 0 || tile_h == 0 {
+        return Err("Image too small to split into the requested number of tiles".to_string());
+    }
+
+    let mut tiles = Vec::with_capacity((cols * rows) as usize);
+
+    for r in 0..rows {
+        for c in 0..cols {
+            let tx = c * tile_w;
+            let ty = r * tile_h;
+            let mut tile = image.crop_imm(tx, ty, tile_w, tile_h);
+
+            if tile_settings.border_each_tile {
+                if let Some(border) = border_settings {
+                    tile = apply_border(tile, border)?;
+                }
+            }
+            tiles.push(tile);
+        }
+    }
+
+    Ok(tiles)
+}
