@@ -0,0 +1,483 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useTranslation } from 'react-i18next';
+import { Maximize2, X, Image as ImageIcon, Grid, Layers, SplitSquareVertical } from 'lucide-react';
+import Text from '../../ui/Text';
+import { TextVariants } from '../../../types/typography';
+import { SelectedImage } from '../../ui/AppProperties';
+
+interface ExportLivePreviewProps {
+  selectedImage: SelectedImage | null;
+  finalPreviewUrl?: string | null;
+  multiSelectedPaths: string[];
+  thumbnailMap?: Record<string, string>;
+  enableBorder: boolean;
+  borderSize: number;
+  borderColor: string;
+  enableKeyline: boolean;
+  keylineSize: number;
+  keylineColor: string;
+  keylineInset: number;
+  enableGridOverlay: boolean;
+  gridOverlayRows: number;
+  gridOverlayCols: number;
+  gridOverlayColor: string;
+  gridOverlayOpacity: number;
+  gridOverlaySize?: number;
+  enableCollageGrid: boolean;
+  collageColumns: number;
+  collageRows: number;
+  collageGutter: number;
+  collageCellFit: 'fit' | 'fill';
+  enableTileSplit: boolean;
+  tileSplitColumns: number;
+  tileSplitRows: number;
+  tileBorderEachTile: boolean;
+}
+
+export default function ExportLivePreview({
+  selectedImage,
+  finalPreviewUrl,
+  multiSelectedPaths,
+  thumbnailMap = {},
+  enableBorder,
+  borderSize,
+  borderColor,
+  enableKeyline,
+  keylineSize,
+  keylineColor,
+  keylineInset,
+  enableGridOverlay,
+  gridOverlayRows,
+  gridOverlayCols,
+  gridOverlayColor,
+  gridOverlayOpacity,
+  gridOverlaySize = 1,
+  enableCollageGrid,
+  collageColumns,
+  collageRows,
+  collageGutter,
+  collageCellFit,
+  enableTileSplit,
+  tileSplitColumns,
+  tileSplitRows,
+}: ExportLivePreviewProps) {
+  const { t } = useTranslation();
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const modalCanvasRef = useRef<HTMLCanvasElement | null>(null);
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [loadedImages, setLoadedImages] = useState<HTMLImageElement[]>([]);
+  const [imageRatio, setImageRatio] = useState<number>(1.5);
+
+  // Collect image URLs to display:
+  const activeImageUrls = React.useMemo(() => {
+    if (enableCollageGrid && multiSelectedPaths.length > 1) {
+      return multiSelectedPaths.map(
+        (p) => thumbnailMap[p] || (p === selectedImage?.path ? finalPreviewUrl || selectedImage?.thumbnailUrl : '') || ''
+      ).filter(Boolean);
+    }
+    const single = finalPreviewUrl || selectedImage?.thumbnailUrl;
+    return single ? [single] : [];
+  }, [enableCollageGrid, multiSelectedPaths, thumbnailMap, selectedImage, finalPreviewUrl]);
+
+  // Preload images into HTMLImageElement objects
+  useEffect(() => {
+    let cancelled = false;
+    if (activeImageUrls.length === 0) {
+      setLoadedImages([]);
+      return;
+    }
+
+    Promise.all(
+      activeImageUrls.map((url) => {
+        return new Promise<HTMLImageElement | null>((resolve) => {
+          const img = new Image();
+          img.crossOrigin = 'anonymous';
+          img.onload = () => resolve(img);
+          img.onerror = () => resolve(null);
+          img.src = url;
+        });
+      })
+    ).then((imgs) => {
+      if (cancelled) return;
+      const valid = imgs.filter((i): i is HTMLImageElement => i !== null);
+      setLoadedImages(valid);
+      if (valid.length > 0) {
+        setImageRatio(valid[0].naturalWidth / (valid[0].naturalHeight || 1));
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [activeImageUrls]);
+
+  // Canvas drawing function
+  const renderToCanvas = React.useCallback(
+    (canvas: HTMLCanvasElement | null, maxDim: number) => {
+      if (!canvas) return;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+
+      if (loadedImages.length === 0) {
+        canvas.width = maxDim;
+        canvas.height = Math.round(maxDim / 1.5);
+        ctx.fillStyle = '#1e1e1e';
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+        ctx.fillStyle = '#666';
+        ctx.font = '14px sans-serif';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(t('export.preview.noImage', 'No image preview available'), canvas.width / 2, canvas.height / 2);
+        return;
+      }
+
+      const isCollage = enableCollageGrid && loadedImages.length > 1;
+      const cols = isCollage ? Math.max(1, collageColumns) : 1;
+      const rows = isCollage ? Math.max(1, collageRows) : 1;
+
+      // Base cell dimensions:
+      const cellW = 400;
+      const cellH = Math.round(cellW / (imageRatio > 0 ? imageRatio : 1.5));
+      const gutterPx = isCollage ? Math.round((cellW * collageGutter) / 100) : 0;
+
+      const innerContentW = cols * cellW + (cols - 1) * gutterPx;
+      const innerContentH = rows * cellH + (rows - 1) * gutterPx;
+
+      // Border math:
+      const borderSizeVal = enableBorder ? Math.max(0, borderSize) : 0;
+      const borderXPx = Math.round((innerContentW * borderSizeVal) / 100);
+      const borderYPx = Math.round((innerContentH * borderSizeVal) / 100);
+
+      const totalCanvasW = innerContentW + borderXPx * 2;
+      const totalCanvasH = innerContentH + borderYPx * 2;
+
+      // Fit into target display size while preserving crispness:
+      const scale = Math.min(maxDim / totalCanvasW, (maxDim * 0.8) / totalCanvasH, 1.0);
+      canvas.width = Math.round(totalCanvasW * scale);
+      canvas.height = Math.round(totalCanvasH * scale);
+
+      ctx.save();
+      ctx.scale(scale, scale);
+
+      // 1. Draw canvas background / outer border
+      ctx.fillStyle = enableBorder ? borderColor : '#111111';
+      ctx.fillRect(0, 0, totalCanvasW, totalCanvasH);
+
+      // 2. Render photos / cells
+      const startX = borderXPx;
+      const startY = borderYPx;
+
+      for (let r = 0; r < rows; r++) {
+        for (let c = 0; c < cols; c++) {
+          const imgIdx = r * cols + c;
+          const img = loadedImages[imgIdx % loadedImages.length];
+          const x = startX + c * (cellW + gutterPx);
+          const y = startY + r * (cellH + gutterPx);
+
+          // Cell background in case of 'fit'
+          ctx.fillStyle = enableBorder ? borderColor : '#1e1e1e';
+          ctx.fillRect(x, y, cellW, cellH);
+
+          if (img) {
+            ctx.save();
+            ctx.beginPath();
+            ctx.rect(x, y, cellW, cellH);
+            ctx.clip();
+
+            const imgAspect = img.naturalWidth / (img.naturalHeight || 1);
+            const cellAspect = cellW / cellH;
+
+            let dw = cellW;
+            let dh = cellH;
+            let dx = x;
+            let dy = y;
+
+            if (collageCellFit === 'fill') {
+              // Center crop
+              if (imgAspect > cellAspect) {
+                dw = cellH * imgAspect;
+                dx = x - (dw - cellW) / 2;
+              } else {
+                dh = cellW / imgAspect;
+                dy = y - (dh - cellH) / 2;
+              }
+            } else {
+              // Fit (letterbox)
+              if (imgAspect > cellAspect) {
+                dh = cellW / imgAspect;
+                dy = y + (cellH - dh) / 2;
+              } else {
+                dw = cellH * imgAspect;
+                dx = x + (cellW - dw) / 2;
+              }
+            }
+
+            ctx.drawImage(img, dx, dy, dw, dh);
+            ctx.restore();
+          }
+
+          // 3. Optional Keyline per cell or overall image
+          if (enableKeyline) {
+            ctx.save();
+            ctx.strokeStyle = keylineColor;
+            const strokeW = Math.max(1, Math.round((cellW * keylineSize) / 100));
+            ctx.lineWidth = strokeW;
+            const insetPx = Math.round((cellW * keylineInset) / 100);
+            ctx.strokeRect(
+              x - insetPx,
+              y - insetPx,
+              cellW + insetPx * 2,
+              cellH + insetPx * 2
+            );
+            ctx.restore();
+          }
+        }
+      }
+
+      // 4. Grid overlay lines (Rule of Thirds or custom grid)
+      if (enableGridOverlay) {
+        ctx.save();
+        ctx.strokeStyle = gridOverlayColor;
+        ctx.globalAlpha = Math.max(0, Math.min(100, gridOverlayOpacity)) / 100;
+        ctx.lineWidth = Math.max(1, gridOverlaySize);
+
+        const gCols = Math.max(1, gridOverlayCols);
+        const gRows = Math.max(1, gridOverlayRows);
+
+        for (let i = 1; i < gCols; i++) {
+          const gx = startX + (innerContentW * i) / gCols;
+          ctx.beginPath();
+          ctx.moveTo(gx, startY);
+          ctx.lineTo(gx, startY + innerContentH);
+          ctx.stroke();
+        }
+
+        for (let j = 1; j < gRows; j++) {
+          const gy = startY + (innerContentH * j) / gRows;
+          ctx.beginPath();
+          ctx.moveTo(startX, gy);
+          ctx.lineTo(startX + innerContentW, gy);
+          ctx.stroke();
+        }
+        ctx.restore();
+      }
+
+      // 5. Multi-Tile Splitter cut-guides
+      if (enableTileSplit) {
+        ctx.save();
+        const tCols = Math.max(1, tileSplitColumns);
+        const tRows = Math.max(1, tileSplitRows);
+
+        ctx.strokeStyle = '#38bdf8'; // Sky blue dashed lines
+        ctx.lineWidth = 2;
+        ctx.setLineDash([6, 6]);
+
+        const tileW = totalCanvasW / tCols;
+        const tileH = totalCanvasH / tRows;
+
+        for (let tc = 1; tc < tCols; tc++) {
+          const tx = tc * tileW;
+          ctx.beginPath();
+          ctx.moveTo(tx, 0);
+          ctx.lineTo(tx, totalCanvasH);
+          ctx.stroke();
+        }
+
+        for (let tr = 1; tr < tRows; tr++) {
+          const ty = tr * tileH;
+          ctx.beginPath();
+          ctx.moveTo(0, ty);
+          ctx.lineTo(totalCanvasW, ty);
+          ctx.stroke();
+        }
+
+        // Draw tile index badges
+        ctx.setLineDash([]);
+        ctx.font = 'bold 12px sans-serif';
+        ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
+        ctx.strokeStyle = '#38bdf8';
+        ctx.lineWidth = 1;
+
+        let tileCount = 1;
+        for (let r = 0; r < tRows; r++) {
+          for (let c = 0; c < tCols; c++) {
+            const bx = c * tileW + 8;
+            const by = r * tileH + 8;
+            const text = `Tile ${tileCount++}`;
+            const metrics = ctx.measureText(text);
+            ctx.fillRect(bx, by, metrics.width + 12, 20);
+            ctx.strokeRect(bx, by, metrics.width + 12, 20);
+            ctx.fillStyle = '#ffffff';
+            ctx.fillText(text, bx + 6, by + 14);
+            ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
+          }
+        }
+
+        ctx.restore();
+      }
+
+      ctx.restore();
+    },
+    [
+      loadedImages,
+      enableCollageGrid,
+      collageColumns,
+      collageRows,
+      collageGutter,
+      collageCellFit,
+      imageRatio,
+      enableBorder,
+      borderSize,
+      borderColor,
+      enableKeyline,
+      keylineSize,
+      keylineColor,
+      keylineInset,
+      enableGridOverlay,
+      gridOverlayCols,
+      gridOverlayRows,
+      gridOverlayColor,
+      gridOverlayOpacity,
+      gridOverlaySize,
+      enableTileSplit,
+      tileSplitColumns,
+      tileSplitRows,
+      t,
+    ]
+  );
+
+  // Render on main panel canvas
+  useEffect(() => {
+    renderToCanvas(canvasRef.current, 380);
+  }, [renderToCanvas]);
+
+  // Render on modal canvas if modal open
+  useEffect(() => {
+    if (isModalOpen) {
+      renderToCanvas(modalCanvasRef.current, 900);
+    }
+  }, [isModalOpen, renderToCanvas]);
+
+  const filesCount = React.useMemo(() => {
+    if (enableTileSplit) {
+      return tileSplitColumns * tileSplitRows;
+    }
+    if (enableCollageGrid && multiSelectedPaths.length > 1) {
+      return 1; // All photos consolidated into 1 collage
+    }
+    return Math.max(1, multiSelectedPaths.length);
+  }, [enableTileSplit, tileSplitColumns, tileSplitRows, enableCollageGrid, multiSelectedPaths]);
+
+  return (
+    <div className="sticky top-0 z-10 w-full bg-surface-lowest/95 backdrop-blur-md rounded-lg border border-surface p-3 mb-4 space-y-2 shadow-lg">
+      {/* Header with Title and Expand button */}
+      <div className="flex items-center justify-between">
+        <div className="flex items-center gap-1.5">
+          <ImageIcon className="w-4 h-4 text-accent" />
+          <Text variant={TextVariants.label} className="font-semibold">
+            {t('export.preview.title', 'Live Export Preview')}
+          </Text>
+        </div>
+        <button
+          type="button"
+          aria-label={t('export.preview.expand', 'Expand Preview')}
+          title={t('export.preview.expand', 'Expand Preview')}
+          onClick={() => setIsModalOpen(true)}
+          className="p-1 hover:bg-surface rounded text-subtext hover:text-white transition-colors"
+        >
+          <Maximize2 className="w-3.5 h-3.5" />
+        </button>
+      </div>
+
+      {/* Embedded Live Canvas */}
+      <div className="w-full flex items-center justify-center bg-black/40 rounded border border-surface/50 p-2 overflow-hidden">
+        <canvas
+          ref={canvasRef}
+          className="max-w-full h-auto object-contain rounded shadow-md transition-all duration-75"
+        />
+      </div>
+
+      {/* Status & Badge Info Bar */}
+      <div className="flex flex-wrap items-center justify-between gap-1 text-[11px] text-subtext pt-1">
+        <div className="flex items-center gap-1.5">
+          {enableCollageGrid && multiSelectedPaths.length > 1 && (
+            <span className="inline-flex items-center gap-1 bg-accent/20 text-accent px-1.5 py-0.5 rounded font-mono">
+              <Grid className="w-3 h-3" />
+              {collageColumns}×{collageRows} Collage
+            </span>
+          )}
+          {enableTileSplit && (
+            <span className="inline-flex items-center gap-1 bg-sky-500/20 text-sky-400 px-1.5 py-0.5 rounded font-mono">
+              <SplitSquareVertical className="w-3 h-3" />
+              {tileSplitColumns}×{tileSplitRows} Split
+            </span>
+          )}
+          {enableBorder && (
+            <span className="inline-flex items-center gap-1 bg-surface px-1.5 py-0.5 rounded font-mono">
+              Border: {borderSize}%
+            </span>
+          )}
+        </div>
+        <div className="font-medium text-white/80">
+          {filesCount} {filesCount === 1 ? 'file' : 'files'} to export
+        </div>
+      </div>
+
+      {/* Fullscreen / Enlarged Preview Modal */}
+      {isModalOpen &&
+        (typeof document !== 'undefined'
+          ? createPortal(
+              <div
+                className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-6"
+                onClick={() => setIsModalOpen(false)}
+              >
+                <div
+                  className="relative max-w-4xl w-full bg-surface-lowest rounded-xl border border-surface shadow-2xl p-4 flex flex-col space-y-3"
+                  onClick={(e) => e.stopPropagation()}
+                >
+                  <div className="flex items-center justify-between border-b border-surface pb-2">
+                    <div className="flex items-center gap-2">
+                      <Layers className="w-4 h-4 text-accent" />
+                      <Text variant={TextVariants.heading}>
+                        {t('export.preview.highResTitle', 'Export Output Inspector')}
+                      </Text>
+                    </div>
+                    <button
+                      type="button"
+                      onClick={() => setIsModalOpen(false)}
+                      className="p-1 rounded-md hover:bg-surface text-subtext hover:text-white"
+                    >
+                      <X className="w-5 h-5" />
+                    </button>
+                  </div>
+
+                  <div className="w-full h-[65vh] flex items-center justify-center bg-[radial-gradient(#222_1px,transparent_1px)] [background-size:16px_16px] bg-black/70 rounded-lg overflow-auto p-4 border border-surface/40">
+                    <canvas
+                      ref={modalCanvasRef}
+                      className="max-h-full max-w-full object-contain rounded shadow-2xl"
+                    />
+                  </div>
+
+                  <div className="flex items-center justify-between text-xs text-subtext pt-1">
+                    <span>
+                      {enableCollageGrid && multiSelectedPaths.length > 1
+                        ? `Multi-Photo Collage: ${multiSelectedPaths.length} photos (${collageColumns} cols × ${collageRows} rows)`
+                        : `Single Image Export`}
+                    </span>
+                    <button
+                      type="button"
+                      onClick={() => setIsModalOpen(false)}
+                      className="px-3 py-1 bg-surface hover:bg-surface/80 text-white rounded text-xs"
+                    >
+                      {t('common.close', 'Close')}
+                    </button>
+                  </div>
+                </div>
+              </div>,
+              document.body,
+            )
+          : null)}
